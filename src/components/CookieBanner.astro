---
import Icon from "./Icon.astro";
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[900] hidden justify-center px-4 pb-4 sm:px-6"
  role="region"
  aria-label="Aviso de cookies"
>
  <div class="flex w-full max-w-3xl flex-col gap-3 rounded-2xl border border-navy-100 bg-white p-5 shadow-xl shadow-navy-900/10 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-navy-600">
      Usamos únicamente cookies técnicas necesarias para que puedas iniciar sesión en el campus. No usamos
      cookies de analítica ni publicidad. Más info en nuestra
      <a href="/cookies" class="font-semibold text-sky-700 hover:underline">política de cookies</a>.
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        id="cookie-reject"
        type="button"
        class="rounded-full border border-navy-200 px-4 py-2 text-sm font-bold text-navy-600 transition-colors hover:border-navy-400"
      >
        Rechazar
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-full bg-sky-600 px-5 py-2 text-sm font-bold text-white transition-colors hover:bg-sky-700"
      >
        <Icon name="check" class="size-4" />
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "droneduca-cookie-consent";
  const banner = document.getElementById("cookie-banner");

  if (banner && !localStorage.getItem(STORAGE_KEY)) {
    banner.classList.remove("hidden");
    banner.classList.add("flex");
  }

  function decide(value: "accepted" | "rejected") {
    localStorage.setItem(STORAGE_KEY, value);
    banner?.classList.add("hidden");
    banner?.classList.remove("flex");
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => decide("accepted"));
  document.getElementById("cookie-reject")?.addEventListener("click", () => decide("rejected"));
</script>
