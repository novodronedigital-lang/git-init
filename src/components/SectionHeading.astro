---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, align = "center", class: className = "" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left", className]}>
  {eyebrow && (
    <span class="inline-block rounded-full bg-sky-50 px-4 py-1 text-xs font-bold uppercase tracking-wide text-sky-700">
      {eyebrow}
    </span>
  )}
  <h2 class="mt-3 font-display text-3xl font-extrabold text-navy-900 sm:text-4xl">
    {title}
  </h2>
  <slot />
</div>
