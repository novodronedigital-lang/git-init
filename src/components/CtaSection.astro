---
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "¿Te gustaría realizar alguna actividad con drones para niños?",
  description = "Escríbenos y te contamos cómo llevar la experiencia DronEduca a tu colegio, ayuntamiento o evento.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-sky-600">
  <div class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-sky-500/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-10 size-72 rounded-full bg-navy-900/20 blur-3xl"></div>
  <div class="container-page relative flex flex-col items-center gap-6 py-16 text-center">
    <span class="grid size-14 place-items-center rounded-2xl bg-white/15 text-white">
      <Icon name="drone" class="size-8" />
    </span>
    <h2 class="max-w-2xl font-display text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
    <p class="max-w-xl text-sky-100">{description}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href="/contacto" variant="primary">
        Solicitar información
        <Icon name="arrow-right" class="size-4" />
      </Button>
      <Button href="/precios" variant="ghost" class="!bg-transparent !border-white/40 !text-white hover:!border-white">
        Ver precios
      </Button>
    </div>
  </div>
</section>
