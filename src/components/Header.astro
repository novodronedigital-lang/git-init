---
import { SITE, getNavLinks, getHomeHref, getContactoHref } from "../data/site";
import Icon from "./Icon.astro";

const currentPath = Astro.url.pathname;
const navLinks = getNavLinks();
const homeHref = getHomeHref();
const contactoHref = getContactoHref();

function isActive(href: string) {
  if (href.startsWith("http")) return false;
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-navy-100 bg-white/90 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between py-3">
    <a href={homeHref} class="flex items-center">
      <img src="/brand/logo-lockup-on-light.png" alt={SITE.name} class="h-8 w-auto sm:h-9" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {navLinks.map((link) => (
        <div class="group relative">
          <a
            href={link.href}
            class:list={[
              "flex items-center gap-1 rounded-full px-4 py-2 text-sm font-semibold transition-colors",
              isActive(link.href) ? "bg-sky-50 text-sky-700" : "text-navy-700 hover:bg-navy-50 hover:text-navy-900",
            ]}
          >
            {link.label}
            {link.children && <Icon name="chevron-down" class="size-4 transition-transform group-hover:rotate-180" />}
          </a>
          {link.children && (
            <div class="invisible absolute left-0 top-full w-64 rounded-2xl border border-navy-100 bg-white p-2 opacity-0 shadow-xl shadow-navy-900/5 transition-all group-hover:visible group-hover:opacity-100">
              {link.children.map((child) => (
                <a href={child.href} class="block rounded-xl px-3 py-2.5 text-sm font-medium text-navy-700 hover:bg-sky-50 hover:text-sky-700">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a href={contactoHref} class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600">
        Solicitar actividad
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="grid size-11 place-items-center rounded-full border border-navy-200 text-navy-800 lg:hidden"
    >
      <span id="menu-icon-open"><Icon name="menu" class="size-6" /></span>
      <span id="menu-icon-close" class="hidden"><Icon name="close" class="size-6" /></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4">
      {navLinks.map((link) => (
        <div>
          <a href={link.href} class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-navy-800 hover:bg-navy-50">
            {link.label}
          </a>
          {link.children && (
            <div class="ml-3 flex flex-col border-l border-navy-100 pl-3">
              {link.children.map((child) => (
                <a href={child.href} class="rounded-lg px-3 py-2 text-sm text-navy-600 hover:bg-navy-50 hover:text-navy-900">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href={contactoHref} class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-amber-500 px-5 py-3 text-sm font-bold text-white">
        Solicitar actividad
        <Icon name="arrow-right" class="size-4" />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });
</script>
