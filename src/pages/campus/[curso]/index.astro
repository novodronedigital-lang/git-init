---
import Layout from "../../../layouts/Layout.astro";
import CampusShell from "../../../components/campus/CampusShell.astro";
import Icon from "../../../components/Icon.astro";
import { getCollection } from "astro:content";
import { getContactoHref } from "../../../data/site";

const contactoHref = getContactoHref();

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { curso: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const isWebinar = course.data.campusDesign === "webinar";

// Rama clásica (Drone Starter): lista plana de lecciones, sin agrupar.
let lessonNumber = 0;
const flatLessons = course.data.modules.flatMap((mod) =>
  mod.lessons.map((title) => {
    lessonNumber += 1;
    return { number: lessonNumber, title, moduleTitle: mod.title };
  }),
);

// Rama webinar: primer módulo, para el paso 3 de "cómo empezar".
const firstModule = course.data.modules[0];
---

{isWebinar ? (
  <CampusShell course={course} active="inicio" title={`Inicio · ${course.data.title}`}>
    <p id="loading-state" class="text-sm text-navy-500">Comprobando tu acceso...</p>

    <div id="no-access-state" class="hidden rounded-3xl border border-navy-100 bg-white p-8 text-center text-navy-600">
      Todavía no tienes acceso a este curso.
      <a href={contactoHref} class="font-semibold text-sky-700 hover:underline">Escríbenos</a>
      para solicitarlo.
    </div>

    <div id="course-content" class="hidden">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">
            Hola<span id="welcome-name">​</span> 👋
          </h1>
          <p class="mt-1 max-w-xl text-[13.5px] text-navy-500">{course.data.tagline ?? course.data.title}</p>
        </div>
      </div>

      <h2 class="mt-8 mb-3 font-display text-xs font-extrabold uppercase tracking-wide text-navy-700">Accede directamente</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href={`/campus/${course.id}/clases`} class="campus-tile" style="--tile-a:#4ea1ff;--tile-b:#0c46c2;--tile-shadow:rgba(15,90,239,.45)">
          <span class="campus-tile-ic"><Icon name="book" class="size-4.5" /></span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-[13.5px] font-bold text-navy-900">Clases</span>
            <span class="block text-[11.5px] text-navy-500">{course.data.modules.length} módulos con vídeo</span>
          </span>
          <Icon name="chevron-right" class="size-4 shrink-0 text-navy-300" />
        </a>

        {course.data.calendar && (
          <a href={`/campus/${course.id}/calendario`} class="campus-tile" style="--tile-a:#ffbe4d;--tile-b:#db6a00;--tile-shadow:rgba(251,133,0,.4)">
            <span class="campus-tile-ic"><Icon name="calendar" class="size-4.5" /></span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-[13.5px] font-bold text-navy-900">Calendario</span>
              <span class="block text-[11.5px] text-navy-500">Clases en directo</span>
            </span>
            <Icon name="chevron-right" class="size-4 shrink-0 text-navy-300" />
          </a>
        )}

        <a href={`/campus/${course.id}/acerca`} class="campus-tile" style="--tile-a:#6480a9;--tile-b:#1f2c44;--tile-shadow:rgba(31,44,68,.4)">
          <span class="campus-tile-ic"><Icon name="info" class="size-4.5" /></span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-[13.5px] font-bold text-navy-900">Acerca de</span>
            <span class="block text-[11.5px] text-navy-500">Vídeo y equipo docente</span>
          </span>
          <Icon name="chevron-right" class="size-4 shrink-0 text-navy-300" />
        </a>

        {course.data.forum && (
          <a href={`/campus/${course.id}/foro`} class="campus-tile" style="--tile-a:#86c4ff;--tile-b:#0f2e6e;--tile-shadow:rgba(15,46,110,.4)">
            <span class="campus-tile-ic"><Icon name="users" class="size-4.5" /></span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-[13.5px] font-bold text-navy-900">Foro</span>
              <span class="block text-[11.5px] text-navy-500">Dudas de la comunidad</span>
            </span>
            <Icon name="chevron-right" class="size-4 shrink-0 text-navy-300" />
          </a>
        )}

        {course.data.whatsapp && (
          course.data.whatsappUrl ? (
            <a href={course.data.whatsappUrl} target="_blank" rel="noopener noreferrer" class="campus-tile" style="--tile-a:#3fd67a;--tile-b:#159a49;--tile-shadow:rgba(21,154,73,.4)">
              <span class="campus-tile-ic"><Icon name="whatsapp" class="size-4.5" /></span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-[13.5px] font-bold text-navy-900">Grupo de WhatsApp</span>
                <span class="block text-[11.5px] font-semibold text-amber-700">Abrir grupo</span>
              </span>
              <Icon name="chevron-right" class="size-4 shrink-0 text-navy-300" />
            </a>
          ) : (
            <div class="campus-tile cursor-default opacity-70" style="--tile-a:#3fd67a;--tile-b:#159a49;--tile-shadow:rgba(21,154,73,.4)">
              <span class="campus-tile-ic"><Icon name="whatsapp" class="size-4.5" /></span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-[13.5px] font-bold text-navy-900">Grupo de WhatsApp</span>
                <span class="block text-[11.5px] font-semibold text-amber-700">Enlace pendiente</span>
              </span>
            </div>
          )
        )}
      </div>

      <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h2 class="mb-3 font-display text-xs font-extrabold uppercase tracking-wide text-navy-700">Cómo empezar</h2>
          <ol class="flex flex-col gap-2.5">
            <li class="flex items-start gap-3 rounded-2xl border border-navy-100 bg-white p-3.5">
              <span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-600 font-display text-xs font-bold text-white">1</span>
              <div>
                <p class="text-[13px] font-bold text-navy-900">Mira el vídeo de bienvenida</p>
                <p class="text-xs text-navy-500">
                  En <a href={`/campus/${course.id}/acerca`} class="font-semibold text-sky-700 hover:underline">Acerca de</a>, para saber qué te vas a encontrar.
                </p>
              </div>
            </li>
            {course.data.whatsapp && (
              <li class="flex items-start gap-3 rounded-2xl border border-navy-100 bg-white p-3.5">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-600 font-display text-xs font-bold text-white">2</span>
                <div>
                  <p class="text-[13px] font-bold text-navy-900">Únete al grupo de WhatsApp</p>
                  <p class="text-xs text-navy-500">Ahí resolvemos dudas y avisamos de las clases en directo.</p>
                </div>
              </li>
            )}
            <li class="flex items-start gap-3 rounded-2xl border border-navy-100 bg-white p-3.5">
              <span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-600 font-display text-xs font-bold text-white">{course.data.whatsapp ? 3 : 2}</span>
              <div>
                <p class="text-[13px] font-bold text-navy-900">Empieza por el primer módulo</p>
                <p class="text-xs text-navy-500">
                  Con {firstModule.instructor ?? "tu profesor"} —{" "}
                  <a href={`/campus/${course.id}/clases/1`} class="font-semibold text-sky-700 hover:underline">{firstModule.title}</a>.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div>
          <h2 class="mb-3 font-display text-xs font-extrabold uppercase tracking-wide text-navy-700">Próximas clases</h2>
          {course.data.calendar ? (
            <div class="rounded-2xl border border-navy-100 bg-white p-4">
              <div class="mb-3 flex items-center justify-between">
                <span id="mini-cal-label" class="font-display text-[13.5px] font-extrabold text-navy-900"></span>
                <a href={`/campus/${course.id}/calendario`} class="text-[11.5px] font-bold text-sky-700 hover:underline">Ver todo →</a>
              </div>
              <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-navy-300">
                <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
              </div>
              <div id="mini-cal-grid" class="mt-1 grid grid-cols-7 gap-1"></div>
              <p id="mini-cal-loading" class="mt-2 text-xs text-navy-400">Cargando...</p>
            </div>
          ) : (
            <div class="rounded-2xl border border-dashed border-navy-200 bg-white p-4 text-xs text-navy-500">
              Este curso no incluye clases en directo por ahora.
            </div>
          )}
        </div>
      </div>
    </div>

    <style>
      .campus-tile {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 16px;
        border: 1px solid var(--color-navy-100);
        background: #fff;
        padding: 13px 14px;
        transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
      }
      .campus-tile:hover {
        border-color: var(--color-sky-300);
        transform: translateY(-2px);
        box-shadow: 0 14px 26px -18px rgba(10, 17, 32, 0.3);
      }
      .campus-tile-ic {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        flex-shrink: 0;
        color: #fff;
        background: linear-gradient(150deg, var(--tile-a), var(--tile-b));
        box-shadow: 0 6px 14px -6px var(--tile-shadow);
      }
    </style>
  </CampusShell>
) : (
  <Layout title={course.data.title} description={course.data.description}>
    <section class="bg-sky-50/60 py-12 sm:py-16">
      <div class="container-page">
        <a href="/campus" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
          ← Mi campus
        </a>
        <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
          {course.data.title}
        </h1>
      </div>
    </section>

    <section class="py-16 sm:py-20">
      <div class="container-page max-w-3xl">
        <p id="loading-state" class="text-sm text-navy-500">Comprobando tu acceso...</p>

        <div id="no-access-state" class="hidden rounded-3xl border border-navy-100 bg-white p-8 text-center text-navy-600">
          Todavía no tienes acceso a este curso.
          <a href={contactoHref} class="font-semibold text-sky-700 hover:underline">Escríbenos</a>
          para solicitarlo.
        </div>

        <div id="course-content" class="hidden">
          <div class="space-y-2">
            {flatLessons.map((lesson) => (
              <a
                href={`/campus/${course.id}/leccion/${lesson.number}`}
                data-lesson-number={lesson.number}
                class="flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
              >
                <span data-lesson-check class="grid size-9 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-400">
                  <Icon name="play" class="size-4" />
                </span>
                <span class="flex-1">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-navy-400">{lesson.moduleTitle}</span>
                  <span class="block text-sm font-semibold text-navy-800">{lesson.title}</span>
                </span>
              </a>
            ))}
          </div>

          <a
            href={`/campus/${course.id}/examen`}
            class="mt-6 flex items-center gap-4 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 transition-colors hover:border-amber-400"
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-amber-500 text-white">
              <Icon name="trophy" class="size-4" />
            </span>
            <span class="text-sm font-bold text-amber-800">Examen final</span>
          </a>

          {course.data.forum && (
            <a
              href={`/campus/${course.id}/foro`}
              class="mt-3 flex items-center gap-4 rounded-2xl border border-sky-200 bg-sky-50 px-5 py-4 transition-colors hover:border-sky-400"
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sky-600 text-white">
                <Icon name="users" class="size-4" />
              </span>
              <span class="text-sm font-bold text-sky-800">Foro de la comunidad</span>
            </a>
          )}
        </div>
      </div>
    </section>
  </Layout>
)}

<script>
  import { requireCourseAccess } from "../../../lib/campusAccess";
  import { supabase } from "../../../lib/supabase";

  const courseSlug = window.location.pathname.split("/")[2];
  const access = await requireCourseAccess(courseSlug);
  if (access) {
    const { session, hasAccess } = access;

    const loadingState = document.getElementById("loading-state");
    const noAccessState = document.getElementById("no-access-state");
    const content = document.getElementById("course-content");

    loadingState?.classList.add("hidden");

    if (!hasAccess) {
      noAccessState?.classList.remove("hidden");
    } else {
      content?.classList.remove("hidden");

      const fullName = (session.user.user_metadata?.full_name as string | undefined)?.trim();
      const firstName = fullName?.split(" ")[0];
      const welcomeName = document.getElementById("welcome-name");
      if (welcomeName && firstName) welcomeName.textContent = `, ${firstName}`;

      // Barra de progreso (rama clásica) y estado de las lecciones.
      const { data: lessons } = await supabase.from("lessons").select("id, lesson_order").eq("course_slug", courseSlug);
      const lessonIds = (lessons ?? []).map((l) => l.id);
      const { data: progressRows } = lessonIds.length
        ? await supabase.from("lesson_progress").select("lesson_id").eq("user_id", session.user.id).in("lesson_id", lessonIds)
        : { data: [] };

      const completedIds = new Set((progressRows ?? []).map((p) => p.lesson_id));
      const completedOrders = new Set(
        (lessons ?? []).filter((l) => completedIds.has(l.id)).map((l) => l.lesson_order),
      );

      document.querySelectorAll<HTMLElement>("[data-lesson-number]").forEach((el) => {
        const number = Number(el.dataset.lessonNumber);
        if (completedOrders.has(number)) {
          const check = el.querySelector<HTMLElement>("[data-lesson-check]");
          check?.classList.remove("bg-navy-50", "text-navy-400");
          check?.classList.add("bg-sky-600", "text-white");
        }
      });

      // Mini calendario (rama webinar).
      const miniGrid = document.getElementById("mini-cal-grid");
      if (miniGrid) {
        const { buildMonthGrid, MONTH_NAMES } = await import("../../../lib/calendar");
        const { data: sessions } = await supabase
          .from("live_sessions")
          .select("id, title, starts_at, join_url")
          .eq("course_slug", courseSlug);

        const today = new Date();
        const days = buildMonthGrid(today.getFullYear(), today.getMonth(), sessions ?? []);
        const label = document.getElementById("mini-cal-label");
        if (label) label.textContent = `${MONTH_NAMES[today.getMonth()]} ${today.getFullYear()}`;

        miniGrid.innerHTML = "";
        for (const day of days) {
          const cell = document.createElement("div");
          cell.className = [
            "grid aspect-square place-items-center rounded-lg text-[11px]",
            day.inMonth ? "text-navy-600" : "text-navy-200",
            day.isToday ? "bg-navy-900 font-bold text-white" : "",
          ].join(" ");
          cell.textContent = String(day.date.getDate());
          if (day.sessions.length > 0) {
            const pip = document.createElement("span");
            pip.className = day.isToday
              ? "ml-0.5 inline-block size-1 rounded-full bg-amber-300"
              : "ml-0.5 inline-block size-1 rounded-full bg-amber-500";
            cell.appendChild(pip);
          }
          miniGrid.appendChild(cell);
        }
        document.getElementById("mini-cal-loading")?.classList.add("hidden");
      }
    }
  }
</script>
