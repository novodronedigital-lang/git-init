---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { curso: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;

let lessonNumber = 0;
const flatLessons = course.data.modules.flatMap((mod) =>
  mod.lessons.map((title) => {
    lessonNumber += 1;
    return { number: lessonNumber, title, moduleTitle: mod.title };
  }),
);
---

<Layout title={course.data.title} description={course.data.description}>
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <a href="/campus" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
        ← Mi campus
      </a>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
        {course.data.title}
      </h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-3xl">
      <p id="loading-state" class="text-sm text-navy-500">Comprobando tu acceso...</p>

      <div id="no-access-state" class="hidden rounded-3xl border border-navy-100 bg-white p-8 text-center text-navy-600">
        Todavía no tienes acceso a este curso.
        <a href="/contacto" class="font-semibold text-sky-700 hover:underline">Escríbenos</a>
        para solicitarlo.
      </div>

      <div id="course-content" class="hidden">
        <div class="space-y-2">
          {flatLessons.map((lesson) => (
            <a
              href={`/campus/${course.id}/leccion/${lesson.number}`}
              data-lesson-number={lesson.number}
              class="flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
            >
              <span data-lesson-check class="grid size-9 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-400">
                <Icon name="play" class="size-4" />
              </span>
              <span class="flex-1">
                <span class="block text-xs font-semibold uppercase tracking-wide text-navy-400">{lesson.moduleTitle}</span>
                <span class="block text-sm font-semibold text-navy-800">{lesson.title}</span>
              </span>
            </a>
          ))}
        </div>

        <a
          href={`/campus/${course.id}/examen`}
          class="mt-6 flex items-center gap-4 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 transition-colors hover:border-amber-400"
        >
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-amber-500 text-white">
            <Icon name="trophy" class="size-4" />
          </span>
          <span class="text-sm font-bold text-amber-800">Examen final</span>
        </a>

        {course.data.forum && (
          <a
            href={`/campus/${course.id}/foro`}
            class="mt-3 flex items-center gap-4 rounded-2xl border border-sky-200 bg-sky-50 px-5 py-4 transition-colors hover:border-sky-400"
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sky-600 text-white">
              <Icon name="users" class="size-4" />
            </span>
            <span class="text-sm font-bold text-sky-800">Foro de la comunidad</span>
          </a>
        )}

        {course.data.calendar && (
          <a
            href={`/campus/${course.id}/calendario`}
            class="mt-3 flex items-center gap-4 rounded-2xl border border-navy-200 bg-navy-50 px-5 py-4 transition-colors hover:border-navy-400"
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-navy-800 text-white">
              <Icon name="calendar" class="size-4" />
            </span>
            <span class="text-sm font-bold text-navy-800">Calendario de clases en directo</span>
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireSession } from "../../../lib/auth";
  import { isAdmin } from "../../../lib/admin";
  import { supabase } from "../../../lib/supabase";

  const session = await requireSession();
  if (session) {
    const courseSlug = window.location.pathname.split("/")[2];

    const loadingState = document.getElementById("loading-state");
    const noAccessState = document.getElementById("no-access-state");
    const content = document.getElementById("course-content");

    let hasAccess = courseSlug === "drone-starter";
    if (!hasAccess) {
      const { data: enrollment } = await supabase
        .from("enrollments")
        .select("course_slug")
        .eq("user_id", session.user.id)
        .eq("course_slug", courseSlug)
        .maybeSingle();
      hasAccess = !!enrollment;
    }
    if (!hasAccess) {
      hasAccess = await isAdmin(session.user.id);
    }

    loadingState?.classList.add("hidden");

    if (!hasAccess) {
      noAccessState?.classList.remove("hidden");
    } else {
      content?.classList.remove("hidden");

      const { data: lessons } = await supabase.from("lessons").select("id, lesson_order").eq("course_slug", courseSlug);

      const lessonIds = (lessons ?? []).map((l) => l.id);
      const { data: progressRows } = lessonIds.length
        ? await supabase.from("lesson_progress").select("lesson_id").eq("user_id", session.user.id).in("lesson_id", lessonIds)
        : { data: [] };

      const completedIds = new Set((progressRows ?? []).map((p) => p.lesson_id));
      const completedOrders = new Set(
        (lessons ?? []).filter((l) => completedIds.has(l.id)).map((l) => l.lesson_order),
      );

      document.querySelectorAll<HTMLElement>("[data-lesson-number]").forEach((el) => {
        const number = Number(el.dataset.lessonNumber);
        if (completedOrders.has(number)) {
          const check = el.querySelector<HTMLElement>("[data-lesson-check]");
          check?.classList.remove("bg-navy-50", "text-navy-400");
          check?.classList.add("bg-sky-600", "text-white");
        }
      });
    }
  }
</script>
