---
import CampusShell from "../../../../components/campus/CampusShell.astro";
import Icon from "../../../../components/Icon.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses
    .filter((course) => course.data.calendar)
    .map((course) => ({
      params: { curso: course.id },
      props: { course },
    }));
}

const { course } = Astro.props;
---

<CampusShell course={course} active="calendario" title={`Calendario · ${course.data.title}`} description="Próximas clases en directo del curso.">
  <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Calendario de clases</h1>

  <div class="mt-6 rounded-2xl border border-navy-100 bg-white p-5 sm:p-7">
    <div class="flex items-center justify-between">
      <button id="prev-month" type="button" class="rounded-full border border-navy-200 p-2 text-navy-600 hover:border-sky-400">
        <Icon name="arrow-right" class="size-4 rotate-180" />
      </button>
      <h2 id="month-label" class="font-display text-lg font-bold text-navy-900"></h2>
      <button id="next-month" type="button" class="rounded-full border border-navy-200 p-2 text-navy-600 hover:border-sky-400">
        <Icon name="arrow-right" class="size-4" />
      </button>
    </div>

    <div id="weekday-row" class="mt-6 grid grid-cols-7 gap-1 text-center text-xs font-bold uppercase text-navy-400"></div>
    <div id="calendar-grid" class="mt-2 grid grid-cols-7 gap-1"></div>
  </div>

  <div class="mt-8">
    <h2 class="font-display text-lg font-bold text-navy-900">Próximas clases</h2>
    <p id="no-sessions" class="mt-3 hidden text-sm text-navy-500">No hay clases programadas todavía.</p>
    <div id="upcoming-list" class="mt-3 space-y-2"></div>
  </div>

  <template id="upcoming-row-template">
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-navy-100 bg-white px-5 py-4">
      <div>
        <p class="text-sm font-bold text-navy-900" data-field="title"></p>
        <p class="text-xs text-navy-500" data-field="when"></p>
      </div>
      <a data-field="join" class="hidden inline-flex items-center gap-1.5 rounded-full bg-sky-600 px-4 py-2 text-xs font-bold text-white hover:bg-sky-700" target="_blank" rel="noopener noreferrer">
        Unirse
      </a>
    </div>
  </template>
</CampusShell>

<script>
  import { requireSession } from "../../../../lib/auth";
  import { supabase } from "../../../../lib/supabase";
  import { buildMonthGrid, MONTH_NAMES, WEEKDAY_LABELS, type CalendarSession } from "../../../../lib/calendar";

  const session = await requireSession();
  if (session) {
    const courseSlug = window.location.pathname.split("/")[2];

    const monthLabel = document.getElementById("month-label")!;
    const weekdayRow = document.getElementById("weekday-row")!;
    const grid = document.getElementById("calendar-grid")!;
    const prevButton = document.getElementById("prev-month") as HTMLButtonElement;
    const nextButton = document.getElementById("next-month") as HTMLButtonElement;
    const upcomingList = document.getElementById("upcoming-list")!;
    const noSessions = document.getElementById("no-sessions")!;
    const upcomingTemplate = document.getElementById("upcoming-row-template") as HTMLTemplateElement;

    WEEKDAY_LABELS.forEach((label) => {
      const el = document.createElement("span");
      el.textContent = label;
      weekdayRow.appendChild(el);
    });

    const { data } = await supabase
      .from("live_sessions")
      .select("id, title, starts_at, join_url")
      .eq("course_slug", courseSlug)
      .order("starts_at", { ascending: true });
    const sessions: (CalendarSession & { id: string })[] = data ?? [];

    const today = new Date();
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();

    function renderGrid() {
      monthLabel.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
      grid.innerHTML = "";

      const days = buildMonthGrid(viewYear, viewMonth, sessions);
      for (const day of days) {
        const cell = document.createElement("div");
        cell.className = [
          "min-h-20 rounded-xl border p-1.5 text-xs",
          day.inMonth ? "border-navy-100 bg-white" : "border-navy-50 bg-navy-50/40 text-navy-300",
          day.isToday ? "ring-2 ring-sky-400" : "",
        ].join(" ");

        const dayNumber = document.createElement("div");
        dayNumber.className = "font-bold";
        dayNumber.textContent = String(day.date.getDate());
        cell.appendChild(dayNumber);

        for (const session of day.sessions) {
          const pill = document.createElement("div");
          pill.className = "mt-1 truncate rounded-lg bg-sky-50 px-1.5 py-1 text-sky-800";
          const time = new Date(session.starts_at).toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });
          pill.textContent = `${time} ${session.title}`;
          cell.appendChild(pill);
        }

        grid.appendChild(cell);
      }
    }

    prevButton.addEventListener("click", () => {
      viewMonth -= 1;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear -= 1;
      }
      renderGrid();
    });

    nextButton.addEventListener("click", () => {
      viewMonth += 1;
      if (viewMonth > 11) {
        viewMonth = 0;
        viewYear += 1;
      }
      renderGrid();
    });

    renderGrid();

    const now = new Date();
    const upcoming = sessions.filter((s) => new Date(s.starts_at) >= now);
    const dateFormatter = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });

    if (upcoming.length === 0) {
      noSessions.classList.remove("hidden");
    } else {
      for (const session of upcoming) {
        const node = upcomingTemplate.content.cloneNode(true) as DocumentFragment;
        node.querySelector('[data-field="title"]')!.textContent = session.title;
        node.querySelector('[data-field="when"]')!.textContent = dateFormatter.format(new Date(session.starts_at));
        if (session.join_url) {
          const joinLink = node.querySelector('[data-field="join"]') as HTMLAnchorElement;
          joinLink.href = session.join_url;
          joinLink.classList.remove("hidden");
        }
        upcomingList.appendChild(node);
      }
    }
  }
</script>
