---
import Layout from "../../../../layouts/Layout.astro";
import Icon from "../../../../components/Icon.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.flatMap((course) => {
    let n = 0;
    const flatLessons = course.data.modules.flatMap((mod) =>
      mod.lessons.map((title) => {
        n += 1;
        return { number: n, title, moduleTitle: mod.title };
      }),
    );
    const total = flatLessons.length;

    return flatLessons.map((lesson) => ({
      params: { curso: course.id, numero: String(lesson.number) },
      props: { course, lesson, total },
    }));
  });
}

const { course, lesson, total } = Astro.props;
const prevHref = lesson.number > 1 ? `/campus/${course.id}/leccion/${lesson.number - 1}` : null;
const nextHref =
  lesson.number < total ? `/campus/${course.id}/leccion/${lesson.number + 1}` : `/campus/${course.id}/examen`;
const nextLabel = lesson.number < total ? "Siguiente lección" : "Ir al examen final";
---

<Layout title={`${lesson.title} · ${course.data.title}`} description={course.data.description}>
  <section class="bg-sky-50/60 py-10 sm:py-12">
    <div class="container-page">
      <a href={`/campus/${course.id}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
        ← {course.data.title}
      </a>
      <span class="mt-4 block text-xs font-semibold uppercase tracking-wide text-navy-400">{lesson.moduleTitle}</span>
      <h1 class="mt-1 font-display text-2xl font-extrabold leading-tight text-navy-900 sm:text-3xl">{lesson.title}</h1>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-page max-w-3xl">
      <div id="lesson-loading" class="text-sm text-navy-500">Cargando lección...</div>

      <div id="lesson-content" class="hidden">
        <div id="video-wrapper" class="hidden aspect-video overflow-hidden rounded-3xl bg-navy-950">
          <iframe
            id="video-frame"
            class="size-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>

        <div id="lesson-body" class="prose-content mt-8 whitespace-pre-line"></div>

        <button
          id="complete-button"
          type="button"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
        >
          <Icon name="check" class="size-4" />
          <span id="complete-button-label">Marcar como completada</span>
        </button>
      </div>

      <p id="no-content" class="hidden rounded-3xl border border-navy-100 bg-white p-8 text-center text-navy-600">
        Esta lección todavía no tiene contenido disponible. Vuelve pronto.
      </p>

      <div class="mt-10 flex items-center justify-between border-t border-navy-100 pt-6">
        {prevHref ? (
          <a href={prevHref} class="text-sm font-semibold text-sky-700 hover:underline">← Lección anterior</a>
        ) : <span></span>}
        <a href={nextHref} class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700 hover:underline">
          {nextLabel}
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireSession } from "../../../../lib/auth";
  import { supabase } from "../../../../lib/supabase";

  const ALLOWED_VIDEO_HOSTS = ["www.youtube.com", "www.youtube-nocookie.com", "player.vimeo.com"];

  const session = await requireSession();
  if (session) {
    const pathParts = window.location.pathname.split("/");
    const courseSlug = pathParts[2];
    const lessonOrder = Number(pathParts[4]);

    const loading = document.getElementById("lesson-loading");
    const content = document.getElementById("lesson-content");
    const noContent = document.getElementById("no-content");
    const videoWrapper = document.getElementById("video-wrapper");
    const videoFrame = document.getElementById("video-frame") as HTMLIFrameElement | null;
    const bodyEl = document.getElementById("lesson-body");
    const completeButton = document.getElementById("complete-button") as HTMLButtonElement | null;
    const completeLabel = document.getElementById("complete-button-label");

    const { data: lessonRow } = await supabase
      .from("lessons")
      .select("id, video_url, body")
      .eq("course_slug", courseSlug)
      .eq("lesson_order", lessonOrder)
      .maybeSingle();

    loading?.classList.add("hidden");

    if (!lessonRow) {
      noContent?.classList.remove("hidden");
    } else {
      content?.classList.remove("hidden");

      if (lessonRow.video_url) {
        try {
          const url = new URL(lessonRow.video_url);
          if (ALLOWED_VIDEO_HOSTS.includes(url.hostname) && videoFrame) {
            videoFrame.src = lessonRow.video_url;
            videoWrapper?.classList.remove("hidden");
          }
        } catch {
          // URL inválida: se omite el vídeo.
        }
      }

      if (bodyEl) bodyEl.textContent = lessonRow.body ?? "";

      const { data: existingProgress } = await supabase
        .from("lesson_progress")
        .select("lesson_id")
        .eq("user_id", session.user.id)
        .eq("lesson_id", lessonRow.id)
        .maybeSingle();

      if (existingProgress) {
        if (completeLabel) completeLabel.textContent = "Lección completada";
        if (completeButton) completeButton.disabled = true;
      }

      completeButton?.addEventListener("click", async () => {
        if (completeButton) completeButton.disabled = true;
        const { error } = await supabase
          .from("lesson_progress")
          .upsert({ user_id: session.user.id, lesson_id: lessonRow.id, completed_at: new Date().toISOString() });

        if (!error && completeLabel) {
          completeLabel.textContent = "Lección completada";
        } else if (error && completeButton) {
          completeButton.disabled = false;
        }
      });
    }
  }
</script>
