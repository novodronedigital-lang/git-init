---
import CampusShell from "../../components/campus/CampusShell.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
const courseSummaries = courses.map((course) => ({
  slug: course.id,
  title: course.data.title,
  tagline: course.data.tagline ?? null,
  thumbnail: course.data.thumbnail ?? null,
  totalLessons: course.data.modules.reduce((sum, m) => sum + m.lessons.length, 0),
}));
---

<CampusShell title="Mi campus">
  <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Mi campus</h1>
  <p class="mt-1 text-[13.5px] text-navy-500">Tus cursos y tu progreso, todo en un mismo sitio.</p>

  <p id="loading-state" class="mt-6 text-sm text-navy-500">Cargando tus cursos...</p>

  <p id="empty-state" class="mt-6 hidden rounded-2xl border border-navy-100 bg-white p-8 text-center text-navy-600">
    Todavía no tienes acceso a ningún curso.
    <a href="/cursos" class="font-semibold text-sky-700 hover:underline">Ver catálogo de cursos</a>
  </p>

  <div id="courses-grid" class="mt-6 hidden grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

  <template id="course-card-template">
    <a class="group flex flex-col overflow-hidden rounded-[20px] border border-navy-100 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-navy-900/10">
      <div data-field="thumb-wrap" class="aspect-video overflow-hidden bg-navy-950">
        <img data-field="thumb-img" class="hidden size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
        <div data-field="thumb-placeholder" class="flex size-full items-center justify-center bg-gradient-to-br from-sky-600 to-navy-950 font-display text-3xl font-extrabold text-white/70">
        </div>
      </div>
      <div class="flex flex-1 flex-col p-5">
        <h3 class="font-display text-lg font-bold text-navy-900" data-field="title"></h3>
        <p class="mt-0.5 text-xs font-semibold text-sky-700" data-field="tagline"></p>
        <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-navy-100">
          <div class="h-full rounded-full bg-gradient-to-r from-sky-500 to-sky-700" data-field="bar"></div>
        </div>
        <div class="mt-2 flex items-center justify-between text-xs text-navy-500">
          <span data-field="count"></span>
          <span class="font-bold text-sky-700" data-field="percent"></span>
        </div>
      </div>
    </a>
  </template>

  <script type="application/json" id="course-summaries-data" set:html={JSON.stringify(courseSummaries)} />
</CampusShell>

<script>
  import { requireSession } from "../../lib/auth";
  import { isAdmin } from "../../lib/admin";
  import { supabase } from "../../lib/supabase";

  interface CourseSummary {
    slug: string;
    title: string;
    tagline: string | null;
    thumbnail: string | null;
    totalLessons: number;
  }

  const courseSummaries: CourseSummary[] = JSON.parse(
    document.getElementById("course-summaries-data")!.textContent!,
  );

  const session = await requireSession();

  if (session) {
    const loadingState = document.getElementById("loading-state");
    const emptyState = document.getElementById("empty-state");
    const grid = document.getElementById("courses-grid");
    const template = document.getElementById("course-card-template") as HTMLTemplateElement;

    const [{ data: progressRows }, { data: enrollmentRows }, admin] = await Promise.all([
      supabase.from("lesson_progress").select("lesson_id, lessons(course_slug)").eq("user_id", session.user.id),
      supabase.from("enrollments").select("course_slug").eq("user_id", session.user.id),
      isAdmin(session.user.id),
    ]);

    const completedByCourse = new Map<string, number>();
    for (const row of progressRows ?? []) {
      const slug = (row as { lessons?: { course_slug?: string } }).lessons?.course_slug;
      if (!slug) continue;
      completedByCourse.set(slug, (completedByCourse.get(slug) ?? 0) + 1);
    }

    const enrolledSlugs = new Set((enrollmentRows ?? []).map((e) => e.course_slug));

    loadingState?.classList.add("hidden");

    const accessible = courseSummaries.filter(
      (c) => c.slug === "drone-starter" || enrolledSlugs.has(c.slug) || admin,
    );

    if (accessible.length === 0) {
      emptyState?.classList.remove("hidden");
    } else {
      grid?.classList.remove("hidden");

      for (const course of accessible) {
        const completed = completedByCourse.get(course.slug) ?? 0;
        const percent = course.totalLessons > 0 ? Math.round((completed / course.totalLessons) * 100) : 0;

        const node = template.content.cloneNode(true) as DocumentFragment;
        const link = node.querySelector("a") as HTMLAnchorElement;
        link.href = `/campus/${course.slug}`;
        node.querySelector('[data-field="title"]')!.textContent = course.title;

        const taglineEl = node.querySelector('[data-field="tagline"]')!;
        if (course.tagline) taglineEl.textContent = course.tagline;
        else taglineEl.remove();

        if (course.thumbnail) {
          const img = node.querySelector('[data-field="thumb-img"]') as HTMLImageElement;
          img.src = course.thumbnail;
          img.alt = course.title;
          img.classList.remove("hidden");
          node.querySelector('[data-field="thumb-placeholder"]')?.remove();
        } else {
          const placeholder = node.querySelector('[data-field="thumb-placeholder"]')!;
          placeholder.textContent = course.title.slice(0, 1);
        }

        (node.querySelector('[data-field="bar"]') as HTMLElement).style.width = `${percent}%`;
        node.querySelector('[data-field="count"]')!.textContent = `${completed} / ${course.totalLessons} lecciones`;
        node.querySelector('[data-field="percent"]')!.textContent = `${percent}%`;
        grid?.appendChild(node);
      }
    }
  }
</script>
