---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
---

<Layout title="Acceder al panel de administración" description="Acceso para administradores de DronEduca.">
  <section class="bg-sky-50/60 py-16 sm:py-20">
    <div class="container-page text-center">
      <span class="inline-block rounded-full bg-navy-950 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-white shadow-sm">
        Admin
      </span>
      <h1 class="mx-auto mt-4 max-w-2xl font-display text-4xl font-extrabold leading-tight text-navy-900 sm:text-5xl">
        Panel de administración
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-navy-600">Solo para el equipo de DronEduca.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-md">
      <p id="checking-state" class="text-center text-sm text-navy-500">Comprobando tu sesión...</p>

      <form id="login-form" class="hidden rounded-3xl border border-navy-100 bg-white p-6 shadow-sm sm:p-10" novalidate>
        <div class="space-y-5">
          <div>
            <label for="email" class="text-sm font-semibold text-navy-800">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
            />
          </div>
          <div>
            <label for="password" class="text-sm font-semibold text-navy-800">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
            />
          </div>
        </div>

        <button
          type="submit"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-navy-950 px-6 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-navy-800 disabled:cursor-not-allowed disabled:opacity-60"
        >
          <Icon name="lock" class="size-4" />
          Entrar
        </button>

        <p id="form-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { signIn, getSession } from "../../lib/auth";
  import { isAdmin, adminHomePath } from "../../lib/admin";

  const IS_DEV = import.meta.env.DEV;
  const CAMPUS_URL = IS_DEV ? "/campus" : "https://formacion.droneduca.es/campus";

  const checkingState = document.getElementById("checking-state");
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorBox = document.getElementById("form-error");

  // Si ya hay sesión (compartida entre subdominios) y es admin, entra directo sin pedir nada.
  const existing = await getSession();
  if (existing && (await isAdmin(existing.user.id))) {
    window.location.href = adminHomePath();
  } else {
    checkingState?.classList.add("hidden");
    form.classList.remove("hidden");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const email = (form.elements.namedItem("email") as HTMLInputElement).value;
      const password = (form.elements.namedItem("password") as HTMLInputElement).value;
      const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;

      errorBox?.classList.add("hidden");
      submitButton.disabled = true;

      const { error } = await signIn(email, password);

      if (error) {
        if (errorBox) {
          errorBox.textContent = "No hemos podido iniciar sesión: revisa tu email y contraseña.";
          errorBox.classList.remove("hidden");
        }
        submitButton.disabled = false;
        return;
      }

      const session = await getSession();
      if (!session || !(await isAdmin(session.user.id))) {
        if (errorBox) {
          errorBox.textContent = "Esta cuenta no tiene permisos de administrador.";
          errorBox.classList.remove("hidden");
        }
        submitButton.disabled = false;
        window.location.href = CAMPUS_URL;
        return;
      }

      window.location.href = adminHomePath();
    });
  }
</script>
