---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { CONTENT_SCHEMAS } from "../../../lib/content-schemas";
import { adminPath } from "../../../lib/admin";

export async function getStaticPaths() {
  return CONTENT_SCHEMAS.map((schema) => ({
    params: { key: schema.key },
    props: { schema },
  }));
}

const { schema } = Astro.props;
---

<Layout title={schema.label} description="Editar contenido de la web.">
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <a href={adminPath("/contenido")} class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
        ← Contenido
      </a>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">{schema.label}</h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-2xl">
      <p id="loading-state" class="text-sm text-navy-500">Cargando contenido...</p>

      <form id="content-form" class="hidden space-y-6">
        <div id="fields-container" class="space-y-6"></div>

        <div>
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
          >
            <Icon name="check" class="size-4" />
            Guardar
          </button>
          <p id="form-status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm" role="status"></p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { requireAdmin } from "../../../lib/admin";
  import { supabase } from "../../../lib/supabase";
  import { getSchema, ICON_OPTIONS, type FieldDef } from "../../../lib/content-schemas";

  function getPath(obj: any, path: string): any {
    return path.split(".").reduce((o, k) => (o == null ? undefined : o[k]), obj);
  }

  function setPath(obj: any, path: string, value: any) {
    const keys = path.split(".");
    let cur = obj;
    for (let i = 0; i < keys.length - 1; i++) {
      if (typeof cur[keys[i]] !== "object" || cur[keys[i]] === null) cur[keys[i]] = {};
      cur = cur[keys[i]];
    }
    cur[keys[keys.length - 1]] = value;
  }

  const admin = await requireAdmin();
  if (admin) {
    const pathParts = window.location.pathname.split("/").filter(Boolean);
    const key = pathParts[pathParts.length - 1];
    const schema = getSchema(key);

    const loadingState = document.getElementById("loading-state")!;
    const form = document.getElementById("content-form") as HTMLFormElement;
    const fieldsContainer = document.getElementById("fields-container")!;
    const statusEl = document.getElementById("form-status")!;

    if (!schema) {
      loadingState.textContent = "No se ha encontrado esta sección.";
    } else {
      const { data } = await supabase.from("site_content").select("content").eq("key", key).maybeSingle();
      const content: Record<string, any> = data?.content ?? {};

      function makeLabel(text: string) {
        const label = document.createElement("label");
        label.className = "text-sm font-semibold text-navy-800";
        label.textContent = text;
        return label;
      }

      function makeTextInput(value: string, onChange: (v: string) => void, multiline: boolean) {
        const el = document.createElement(multiline ? "textarea" : "input") as HTMLInputElement | HTMLTextAreaElement;
        if (!multiline) (el as HTMLInputElement).type = "text";
        else (el as HTMLTextAreaElement).rows = 4;
        el.value = value ?? "";
        el.className =
          "mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100";
        el.addEventListener("input", () => onChange(el.value));
        return el;
      }

      function makeIconSelect(value: string, onChange: (v: string) => void) {
        const select = document.createElement("select");
        select.className =
          "mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100";
        for (const icon of ICON_OPTIONS) {
          const option = document.createElement("option");
          option.value = icon;
          option.textContent = icon;
          if (icon === value) option.selected = true;
          select.appendChild(option);
        }
        select.addEventListener("change", () => onChange(select.value));
        return select;
      }

      function renderStringList(container: HTMLElement, field: FieldDef) {
        const wrapper = document.createElement("div");
        wrapper.appendChild(makeLabel(field.label));

        const items: string[] = getPath(content, field.key) ?? [];
        const listEl = document.createElement("div");
        listEl.className = "mt-2 space-y-2";

        function renderItems() {
          listEl.innerHTML = "";
          items.forEach((item, index) => {
            const row = document.createElement("div");
            row.className = "flex items-center gap-2";
            const input = makeTextInput(item, (v) => {
              items[index] = v;
            }, false);
            (input as HTMLInputElement).className += " flex-1";
            row.appendChild(input);

            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.textContent = "Quitar";
            removeBtn.className = "text-xs font-semibold text-navy-400 hover:text-red-600";
            removeBtn.addEventListener("click", () => {
              items.splice(index, 1);
              renderItems();
            });
            row.appendChild(removeBtn);
            listEl.appendChild(row);
          });
        }
        renderItems();
        wrapper.appendChild(listEl);

        const addBtn = document.createElement("button");
        addBtn.type = "button";
        addBtn.textContent = "+ Añadir";
        addBtn.className = "mt-2 text-xs font-bold text-sky-700 hover:underline";
        addBtn.addEventListener("click", () => {
          items.push("");
          renderItems();
        });
        wrapper.appendChild(addBtn);

        setPath(content, field.key, items);
        container.appendChild(wrapper);
      }

      function renderObjectList(container: HTMLElement, field: FieldDef) {
        const wrapper = document.createElement("div");
        wrapper.appendChild(makeLabel(field.label));

        const items: Record<string, any>[] = getPath(content, field.key) ?? [];
        const listEl = document.createElement("div");
        listEl.className = "mt-2 space-y-4";

        function renderItems() {
          listEl.innerHTML = "";
          items.forEach((item, index) => {
            const card = document.createElement("div");
            card.className = "rounded-2xl border border-navy-100 bg-white p-4 space-y-3";

            for (const subField of field.fields ?? []) {
              const subWrapper = document.createElement("div");
              subWrapper.appendChild(makeLabel(subField.label));

              const onChange = (v: any) => {
                item[subField.key] = v;
              };

              if (subField.type === "textarea") {
                subWrapper.appendChild(makeTextInput(item[subField.key], onChange, true));
              } else if (subField.type === "icon") {
                subWrapper.appendChild(makeIconSelect(item[subField.key], onChange));
              } else if (subField.type === "string-list") {
                renderStringListInto(subWrapper, item, subField);
              } else {
                subWrapper.appendChild(makeTextInput(item[subField.key], onChange, false));
              }
              card.appendChild(subWrapper);
            }

            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.textContent = "Eliminar";
            removeBtn.className = "text-xs font-bold text-red-600 hover:underline";
            removeBtn.addEventListener("click", () => {
              items.splice(index, 1);
              renderItems();
            });
            card.appendChild(removeBtn);

            listEl.appendChild(card);
          });
        }

        function renderStringListInto(parent: HTMLElement, item: Record<string, any>, subField: FieldDef) {
          const subItems: string[] = item[subField.key] ?? [];
          const subListEl = document.createElement("div");
          subListEl.className = "mt-1 space-y-1.5";

          function renderSubItems() {
            subListEl.innerHTML = "";
            subItems.forEach((value, i) => {
              const row = document.createElement("div");
              row.className = "flex items-center gap-2";
              const input = makeTextInput(value, (v) => {
                subItems[i] = v;
              }, false);
              (input as HTMLInputElement).className += " flex-1";
              row.appendChild(input);
              const removeBtn = document.createElement("button");
              removeBtn.type = "button";
              removeBtn.textContent = "×";
              removeBtn.className = "font-bold text-navy-400 hover:text-red-600";
              removeBtn.addEventListener("click", () => {
                subItems.splice(i, 1);
                renderSubItems();
              });
              row.appendChild(removeBtn);
              subListEl.appendChild(row);
            });
          }
          renderSubItems();
          parent.appendChild(subListEl);

          const addBtn = document.createElement("button");
          addBtn.type = "button";
          addBtn.textContent = "+ Añadir";
          addBtn.className = "mt-1 text-xs font-bold text-sky-700 hover:underline";
          addBtn.addEventListener("click", () => {
            subItems.push("");
            renderSubItems();
          });
          parent.appendChild(addBtn);

          item[subField.key] = subItems;
        }

        renderItems();
        wrapper.appendChild(listEl);

        const addBtn = document.createElement("button");
        addBtn.type = "button";
        addBtn.textContent = "+ Añadir";
        addBtn.className = "mt-3 text-xs font-bold text-sky-700 hover:underline";
        addBtn.addEventListener("click", () => {
          const empty: Record<string, any> = {};
          for (const subField of field.fields ?? []) empty[subField.key] = subField.type === "string-list" ? [] : "";
          items.push(empty);
          renderItems();
        });
        wrapper.appendChild(addBtn);

        setPath(content, field.key, items);
        container.appendChild(wrapper);
      }

      for (const field of schema.fields) {
        if (field.type === "string-list") {
          renderStringList(fieldsContainer, field);
        } else if (field.type === "object-list") {
          renderObjectList(fieldsContainer, field);
        } else {
          const wrapper = document.createElement("div");
          wrapper.appendChild(makeLabel(field.label));
          const onChange = (v: string) => setPath(content, field.key, v);
          if (field.type === "textarea") {
            wrapper.appendChild(makeTextInput(getPath(content, field.key), onChange, true));
          } else if (field.type === "icon") {
            wrapper.appendChild(makeIconSelect(getPath(content, field.key), onChange));
          } else {
            wrapper.appendChild(makeTextInput(getPath(content, field.key), onChange, false));
          }
          fieldsContainer.appendChild(wrapper);
        }
      }

      loadingState.classList.add("hidden");
      form.classList.remove("hidden");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;
        submitButton.disabled = true;
        statusEl.classList.add("hidden");

        const { error } = await supabase
          .from("site_content")
          .upsert({ key, content, updated_by: admin.user.id }, { onConflict: "key" });

        submitButton.disabled = false;
        statusEl.textContent = error ? "No se ha podido guardar: " + error.message : "Guardado correctamente.";
        statusEl.className = error
          ? "mt-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"
          : "mt-4 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800";
        statusEl.classList.remove("hidden");
      });
    }
  }
</script>
