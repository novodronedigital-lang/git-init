---
import Layout from "../../../layouts/Layout.astro";
import { CONTENT_SCHEMAS } from "../../../lib/content-schemas";
import { adminPath, adminHomePath } from "../../../lib/admin";

const byPage = new Map<string, typeof CONTENT_SCHEMAS>();
for (const schema of CONTENT_SCHEMAS) {
  const list = byPage.get(schema.page) ?? [];
  list.push(schema);
  byPage.set(schema.page, list);
}
---

<Layout title="Contenido" description="Editar el contenido de las páginas públicas.">
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <a href={adminHomePath()} class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">← Admin</a>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">Contenido</h1>
      <p class="mt-2 text-sm text-navy-500">
        Los cambios se guardan al instante, pero no se ven en la web real hasta que pulses "Publicar cambios" en el
        panel principal.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-3xl space-y-10">
      {[...byPage.entries()].map(([page, schemas]) => (
        <div>
          <h2 class="font-display text-lg font-bold text-navy-900">{page}</h2>
          <div class="mt-4 space-y-2">
            {schemas.map((schema) => (
              <a
                href={adminPath(`/contenido/${schema.key}`)}
                class="block rounded-2xl border border-navy-100 bg-white px-5 py-4 text-sm font-semibold text-navy-800 transition-colors hover:border-sky-300"
              >
                {schema.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { requireAdmin } from "../../../lib/admin";
  await requireAdmin();
</script>
