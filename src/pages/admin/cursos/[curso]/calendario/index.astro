---
import Layout from "../../../../../layouts/Layout.astro";
import Icon from "../../../../../components/Icon.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses
    .filter((course) => course.data.calendar)
    .map((course) => ({
      params: { curso: course.id },
      props: { course },
    }));
}

const { course } = Astro.props;
---

<Layout title={`Calendario · ${course.data.title}`} description="Gestión del calendario de clases en directo.">
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <a href="/admin" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">← Admin</a>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
        Calendario · {course.data.title}
      </h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-3xl">
      <form id="session-form" class="rounded-3xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8" novalidate>
        <h2 class="font-display text-lg font-bold text-navy-900">Añadir clase en directo</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="session-title" class="text-sm font-semibold text-navy-800">Título</label>
            <input
              id="session-title"
              type="text"
              required
              class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
            />
          </div>
          <div>
            <label for="session-datetime" class="text-sm font-semibold text-navy-800">Fecha y hora</label>
            <input
              id="session-datetime"
              type="datetime-local"
              required
              class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
            />
          </div>
          <div>
            <label for="session-url" class="text-sm font-semibold text-navy-800">Enlace para unirse</label>
            <input
              id="session-url"
              type="url"
              placeholder="https://meet.google.com/..."
              class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
            />
          </div>
        </div>
        <button
          type="submit"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
        >
          <Icon name="check" class="size-4" />
          Añadir al calendario
        </button>
        <p id="form-status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm" role="status"></p>
      </form>

      <div class="mt-10 rounded-3xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex items-center justify-between">
          <button id="prev-month" type="button" class="rounded-full border border-navy-200 p-2 text-navy-600 hover:border-sky-400">
            <Icon name="arrow-right" class="size-4 rotate-180" />
          </button>
          <h2 id="month-label" class="font-display text-lg font-bold text-navy-900"></h2>
          <button id="next-month" type="button" class="rounded-full border border-navy-200 p-2 text-navy-600 hover:border-sky-400">
            <Icon name="arrow-right" class="size-4" />
          </button>
        </div>

        <div id="weekday-row" class="mt-6 grid grid-cols-7 gap-1 text-center text-xs font-bold uppercase text-navy-400"></div>
        <div id="calendar-grid" class="mt-2 grid grid-cols-7 gap-1"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireAdmin } from "../../../../../lib/admin";
  import { supabase } from "../../../../../lib/supabase";
  import { buildMonthGrid, MONTH_NAMES, WEEKDAY_LABELS, type CalendarSession } from "../../../../../lib/calendar";

  const admin = await requireAdmin();
  if (admin) {
    const courseSlug = window.location.pathname.split("/")[3];

    const form = document.getElementById("session-form") as HTMLFormElement;
    const titleInput = document.getElementById("session-title") as HTMLInputElement;
    const datetimeInput = document.getElementById("session-datetime") as HTMLInputElement;
    const urlInput = document.getElementById("session-url") as HTMLInputElement;
    const statusEl = document.getElementById("form-status");

    const monthLabel = document.getElementById("month-label")!;
    const weekdayRow = document.getElementById("weekday-row")!;
    const grid = document.getElementById("calendar-grid")!;
    const prevButton = document.getElementById("prev-month") as HTMLButtonElement;
    const nextButton = document.getElementById("next-month") as HTMLButtonElement;

    WEEKDAY_LABELS.forEach((label) => {
      const el = document.createElement("span");
      el.textContent = label;
      weekdayRow.appendChild(el);
    });

    let sessions: (CalendarSession & { id: string })[] = [];
    const today = new Date();
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();

    async function loadSessions() {
      const { data } = await supabase
        .from("live_sessions")
        .select("id, title, starts_at, join_url")
        .eq("course_slug", courseSlug)
        .order("starts_at", { ascending: true });
      sessions = data ?? [];
    }

    function renderGrid() {
      monthLabel.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
      grid.innerHTML = "";

      const days = buildMonthGrid(viewYear, viewMonth, sessions);

      for (const day of days) {
        const cell = document.createElement("div");
        cell.className = [
          "min-h-24 rounded-xl border p-1.5 text-xs",
          day.inMonth ? "border-navy-100 bg-white" : "border-navy-50 bg-navy-50/40 text-navy-300",
          day.isToday ? "ring-2 ring-sky-400" : "",
        ].join(" ");

        const dayNumber = document.createElement("div");
        dayNumber.className = "font-bold";
        dayNumber.textContent = String(day.date.getDate());
        cell.appendChild(dayNumber);

        for (const session of day.sessions) {
          const pill = document.createElement("div");
          pill.className = "mt-1 flex items-center justify-between gap-1 rounded-lg bg-sky-50 px-1.5 py-1 text-sky-800";

          const label = document.createElement("span");
          const time = new Date(session.starts_at).toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });
          label.textContent = `${time} ${session.title}`;
          label.className = "truncate";
          pill.appendChild(label);

          const deleteButton = document.createElement("button");
          deleteButton.type = "button";
          deleteButton.textContent = "×";
          deleteButton.className = "shrink-0 font-bold text-sky-400 hover:text-red-600";
          deleteButton.addEventListener("click", async () => {
            await supabase.from("live_sessions").delete().eq("id", session.id);
            await loadSessions();
            renderGrid();
          });
          pill.appendChild(deleteButton);

          cell.appendChild(pill);
        }

        grid.appendChild(cell);
      }
    }

    prevButton.addEventListener("click", () => {
      viewMonth -= 1;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear -= 1;
      }
      renderGrid();
    });

    nextButton.addEventListener("click", () => {
      viewMonth += 1;
      if (viewMonth > 11) {
        viewMonth = 0;
        viewYear += 1;
      }
      renderGrid();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;
      submitButton.disabled = true;
      statusEl?.classList.add("hidden");

      const { error } = await supabase.from("live_sessions").insert({
        course_slug: courseSlug,
        title: titleInput.value,
        starts_at: new Date(datetimeInput.value).toISOString(),
        join_url: urlInput.value || null,
      });

      submitButton.disabled = false;
      if (statusEl) {
        statusEl.textContent = error ? "No se ha podido guardar: " + error.message : "Clase añadida al calendario.";
        statusEl.className = error
          ? "mt-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"
          : "mt-4 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800";
        statusEl.classList.remove("hidden");
      }

      if (!error) {
        form.reset();
        await loadSessions();
        viewYear = new Date(datetimeInput.value || Date.now()).getFullYear();
        renderGrid();
      }
    });

    await loadSessions();
    renderGrid();
  }
</script>
