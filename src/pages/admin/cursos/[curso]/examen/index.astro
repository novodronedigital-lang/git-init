---
import AdminShell from "../../../../../components/admin/AdminShell.astro";
import Icon from "../../../../../components/Icon.astro";
import { getCollection } from "astro:content";
import { adminHomePath } from "../../../../../lib/admin";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { curso: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
---

<AdminShell title={`Examen · ${course.data.title}`} description="Editar el examen del curso." back={{ href: adminHomePath(), label: "Admin" }}>
  <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Examen · {course.data.title}</h1>

  <div class="mt-6 max-w-2xl">
    <p id="loading-state" class="text-sm text-navy-500">Cargando examen...</p>

    <form id="quiz-form" class="hidden space-y-6">
      <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8">
        <label for="quiz-title" class="text-sm font-semibold text-navy-800">Título del examen</label>
        <input
          id="quiz-title"
          type="text"
          required
          class="mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
        />
      </div>

      <div id="questions-container" class="space-y-6"></div>

      <button
        type="button"
        id="add-question"
        class="inline-flex items-center gap-2 rounded-full border border-navy-200 px-5 py-2.5 text-sm font-bold text-navy-700 hover:border-sky-400 hover:text-sky-700"
      >
        <Icon name="check" class="size-4" />
        Añadir pregunta
      </button>

      <div>
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Guardar examen
        </button>
        <p id="form-status" class="mt-4 hidden rounded-xl px-4 py-3 text-sm" role="status"></p>
      </div>
    </form>
  </div>
</AdminShell>

<script>
  import { requireAdmin } from "../../../../../lib/admin";
  import { supabase } from "../../../../../lib/supabase";

  interface Question {
    question: string;
    options: string[];
    correctIndex: number;
  }

  const admin = await requireAdmin();
  if (admin) {
    const parts = window.location.pathname.split("/").filter(Boolean);
    const courseSlug = parts[parts.indexOf("cursos") + 1];

    const loadingState = document.getElementById("loading-state");
    const form = document.getElementById("quiz-form") as HTMLFormElement;
    const titleInput = document.getElementById("quiz-title") as HTMLInputElement;
    const container = document.getElementById("questions-container") as HTMLElement;
    const addQuestionButton = document.getElementById("add-question") as HTMLButtonElement;
    const statusEl = document.getElementById("form-status");

    const { data: existing } = await supabase
      .from("quizzes")
      .select("id, title, questions")
      .eq("course_slug", courseSlug)
      .maybeSingle();

    let quizId: string | null = existing?.id ?? null;
    let questions: Question[] = (existing?.questions as Question[]) ?? [
      { question: "", options: ["", ""], correctIndex: 0 },
    ];
    titleInput.value = existing?.title ?? `Examen final · ${courseSlug}`;

    function renderQuestions() {
      container.innerHTML = "";

      questions.forEach((q, qIndex) => {
        const card = document.createElement("div");
        card.className = "rounded-3xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8";

        const questionLabel = document.createElement("label");
        questionLabel.className = "text-sm font-semibold text-navy-800";
        questionLabel.textContent = `Pregunta ${qIndex + 1}`;
        card.appendChild(questionLabel);

        const questionInput = document.createElement("input");
        questionInput.type = "text";
        questionInput.required = true;
        questionInput.value = q.question;
        questionInput.className =
          "mt-1.5 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100";
        questionInput.addEventListener("input", () => {
          questions[qIndex].question = questionInput.value;
        });
        card.appendChild(questionInput);

        const optionsWrapper = document.createElement("div");
        optionsWrapper.className = "mt-4 space-y-2";

        q.options.forEach((option, oIndex) => {
          const row = document.createElement("div");
          row.className = "flex items-center gap-2";

          const radio = document.createElement("input");
          radio.type = "radio";
          radio.name = `correct-${qIndex}`;
          radio.checked = q.correctIndex === oIndex;
          radio.className = "size-4 shrink-0 text-sky-600 focus:ring-sky-500";
          radio.title = "Marcar como respuesta correcta";
          radio.addEventListener("change", () => {
            questions[qIndex].correctIndex = oIndex;
          });
          row.appendChild(radio);

          const optionInput = document.createElement("input");
          optionInput.type = "text";
          optionInput.required = true;
          optionInput.value = option;
          optionInput.placeholder = `Opción ${oIndex + 1}`;
          optionInput.className =
            "flex-1 rounded-xl border border-navy-200 px-3 py-2 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100";
          optionInput.addEventListener("input", () => {
            questions[qIndex].options[oIndex] = optionInput.value;
          });
          row.appendChild(optionInput);

          if (q.options.length > 2) {
            const removeOption = document.createElement("button");
            removeOption.type = "button";
            removeOption.textContent = "Quitar";
            removeOption.className = "text-xs font-semibold text-navy-400 hover:text-red-600";
            removeOption.addEventListener("click", () => {
              questions[qIndex].options.splice(oIndex, 1);
              if (questions[qIndex].correctIndex >= questions[qIndex].options.length) {
                questions[qIndex].correctIndex = 0;
              }
              renderQuestions();
            });
            row.appendChild(removeOption);
          }

          optionsWrapper.appendChild(row);
        });

        card.appendChild(optionsWrapper);

        const addOptionButton = document.createElement("button");
        addOptionButton.type = "button";
        addOptionButton.textContent = "+ Añadir opción";
        addOptionButton.className = "mt-3 text-xs font-bold text-sky-700 hover:underline";
        addOptionButton.addEventListener("click", () => {
          questions[qIndex].options.push("");
          renderQuestions();
        });
        card.appendChild(addOptionButton);

        if (questions.length > 1) {
          const removeQuestion = document.createElement("button");
          removeQuestion.type = "button";
          removeQuestion.textContent = "Eliminar pregunta";
          removeQuestion.className = "mt-3 ml-4 text-xs font-bold text-red-600 hover:underline";
          removeQuestion.addEventListener("click", () => {
            questions.splice(qIndex, 1);
            renderQuestions();
          });
          card.appendChild(removeQuestion);
        }

        container.appendChild(card);
      });
    }

    renderQuestions();

    loadingState?.classList.add("hidden");
    form.classList.remove("hidden");

    addQuestionButton.addEventListener("click", () => {
      questions.push({ question: "", options: ["", ""], correctIndex: 0 });
      renderQuestions();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;
      submitButton.disabled = true;
      statusEl?.classList.add("hidden");

      const { error } = await supabase.from("quizzes").upsert(
        {
          ...(quizId ? { id: quizId } : {}),
          course_slug: courseSlug,
          title: titleInput.value,
          questions,
        },
        { onConflict: "course_slug" },
      );

      submitButton.disabled = false;
      if (statusEl) {
        statusEl.textContent = error ? "No se ha podido guardar: " + error.message : "Examen guardado correctamente.";
        statusEl.className = error
          ? "mt-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"
          : "mt-4 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800";
        statusEl.classList.remove("hidden");
      }
    });
  }
</script>
