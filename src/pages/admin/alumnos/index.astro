---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
const freeCourse = courses.find((c) => c.id === "drone-starter");
const paidCourses = courses
  .filter((c) => c.id !== "drone-starter")
  .map((c) => ({ slug: c.id, title: c.data.title }));
---

<Layout title="Alumnos" description="Alumnos registrados y accesos a cursos.">
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <a href="/admin" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">← Admin</a>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">Alumnos</h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-4xl">
      <p id="loading-state" class="text-sm text-navy-500">Cargando alumnos...</p>
      <p id="empty-state" class="hidden rounded-3xl border border-navy-100 bg-white p-8 text-center text-navy-600">
        Todavía no hay alumnos registrados.
      </p>
      <div id="students-list" class="hidden space-y-4"></div>
    </div>
  </section>

  <template id="student-card-template">
    <div class="rounded-2xl border border-navy-100 bg-white p-5">
      <p class="font-display text-base font-bold text-navy-900" data-field="name"></p>
      <p class="text-xs text-navy-500" data-field="email"></p>
      <div class="mt-4 flex flex-wrap gap-2" data-field="courses"></div>
    </div>
  </template>

  <script type="application/json" id="paid-courses-data" set:html={JSON.stringify(paidCourses)} />
  <script type="application/json" id="free-course-data" set:html={JSON.stringify(freeCourse ? { title: freeCourse.data.title } : null)} />
</Layout>

<script>
  import { requireAdmin } from "../../../lib/admin";
  import { supabase } from "../../../lib/supabase";

  interface PaidCourse {
    slug: string;
    title: string;
  }

  const paidCourses: PaidCourse[] = JSON.parse(document.getElementById("paid-courses-data")!.textContent!);
  const freeCourse: { title: string } | null = JSON.parse(document.getElementById("free-course-data")!.textContent!);

  const admin = await requireAdmin();
  if (admin) {
    const loadingState = document.getElementById("loading-state");
    const emptyState = document.getElementById("empty-state");
    const list = document.getElementById("students-list");
    const template = document.getElementById("student-card-template") as HTMLTemplateElement;

    const { data: profiles } = await supabase
      .from("profiles")
      .select("id, full_name, email, created_at")
      .order("created_at", { ascending: false });

    const { data: enrollmentRows } = await supabase.from("enrollments").select("user_id, course_slug");

    loadingState?.classList.add("hidden");

    if (!profiles || profiles.length === 0) {
      emptyState?.classList.remove("hidden");
    } else {
      list?.classList.remove("hidden");

      const enrollmentsByUser = new Map<string, Set<string>>();
      for (const row of enrollmentRows ?? []) {
        const set = enrollmentsByUser.get(row.user_id) ?? new Set<string>();
        set.add(row.course_slug);
        enrollmentsByUser.set(row.user_id, set);
      }

      for (const profile of profiles) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        node.querySelector('[data-field="name"]')!.textContent = profile.full_name || "(sin nombre)";
        node.querySelector('[data-field="email"]')!.textContent = profile.email || "";

        const coursesEl = node.querySelector('[data-field="courses"]') as HTMLElement;
        const userEnrollments = enrollmentsByUser.get(profile.id) ?? new Set<string>();

        if (freeCourse) {
          const badge = document.createElement("span");
          badge.className = "rounded-full bg-navy-50 px-4 py-2 text-xs font-bold text-navy-500";
          badge.textContent = `${freeCourse.title} (automático)`;
          coursesEl.appendChild(badge);
        }

        for (const course of paidCourses) {
          const button = document.createElement("button");
          button.type = "button";

          const setButtonState = (hasAccess: boolean) => {
            button.textContent = hasAccess ? `✓ ${course.title}` : `+ ${course.title}`;
            button.className = hasAccess
              ? "rounded-full bg-sky-600 px-4 py-2 text-xs font-bold text-white"
              : "rounded-full border border-navy-200 px-4 py-2 text-xs font-bold text-navy-600 hover:border-sky-400";
          };
          setButtonState(userEnrollments.has(course.slug));

          button.addEventListener("click", async () => {
            button.disabled = true;
            const currentlyHas = userEnrollments.has(course.slug);

            if (currentlyHas) {
              const { error } = await supabase
                .from("enrollments")
                .delete()
                .eq("user_id", profile.id)
                .eq("course_slug", course.slug);
              if (!error) {
                userEnrollments.delete(course.slug);
                setButtonState(false);
              }
            } else {
              const { error } = await supabase
                .from("enrollments")
                .insert({ user_id: profile.id, course_slug: course.slug, granted_by: admin.user.id });
              if (!error) {
                userEnrollments.add(course.slug);
                setButtonState(true);
              }
            }
            button.disabled = false;
          });

          coursesEl.appendChild(button);
        }

        list?.appendChild(node);
      }
    }
  }
</script>
