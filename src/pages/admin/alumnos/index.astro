---
import AdminShell from "../../../components/admin/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
const freeCourse = courses.find((c) => c.id === "drone-starter");
const paidCourses = courses
  .filter((c) => c.id !== "drone-starter")
  .map((c) => ({ slug: c.id, title: c.data.title }));
---

<AdminShell active="alumnos" title="Alumnos" description="Alumnos registrados y accesos a cursos.">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Alumnos</h1>
    <p id="student-count" class="text-xs font-semibold text-navy-400"></p>
  </div>

  <div class="mt-5 max-w-4xl">
    <input
      id="student-search"
      type="search"
      placeholder="Buscar por nombre o email..."
      class="w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
    />

    <p id="loading-state" class="mt-6 text-sm text-navy-500">Cargando alumnos...</p>
    <p id="empty-state" class="mt-6 hidden rounded-2xl border border-navy-100 bg-white p-8 text-center text-navy-600">
      Todavía no hay alumnos registrados.
    </p>
    <p id="no-results-state" class="mt-6 hidden rounded-2xl border border-navy-100 bg-white p-8 text-center text-navy-600">
      Ningún alumno coincide con la búsqueda.
    </p>
    <div id="students-list" class="mt-6 hidden space-y-4"></div>
  </div>

  <template id="student-card-template">
    <div class="rounded-2xl border border-navy-100 bg-white p-5" data-field="card">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="font-display text-base font-bold text-navy-900" data-field="name"></p>
          <p class="text-xs text-navy-500" data-field="email"></p>
          <p class="text-xs text-navy-400" data-field="phone"></p>
        </div>
        <button
          type="button"
          data-field="revoke"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-navy-200 px-3.5 py-1.5 text-xs font-bold text-navy-500 transition-colors hover:border-red-400 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <Icon name="close" class="size-3.5" />
          Quitar acceso
        </button>
      </div>
      <div class="mt-4 flex flex-wrap gap-2" data-field="courses"></div>
    </div>
  </template>

  <script type="application/json" id="paid-courses-data" set:html={JSON.stringify(paidCourses)} />
  <script type="application/json" id="free-course-data" set:html={JSON.stringify(freeCourse ? { title: freeCourse.data.title } : null)} />
</AdminShell>

<script>
  import { requireAdmin } from "../../../lib/admin";
  import { supabase } from "../../../lib/supabase";

  interface PaidCourse {
    slug: string;
    title: string;
  }

  const paidCourses: PaidCourse[] = JSON.parse(document.getElementById("paid-courses-data")!.textContent!);
  const freeCourse: { title: string } | null = JSON.parse(document.getElementById("free-course-data")!.textContent!);

  interface Profile {
    id: string;
    full_name: string | null;
    email: string | null;
    phone: string | null;
    created_at: string;
  }

  const admin = await requireAdmin();
  if (admin) {
    const loadingState = document.getElementById("loading-state");
    const emptyState = document.getElementById("empty-state");
    const noResultsState = document.getElementById("no-results-state");
    const list = document.getElementById("students-list")!;
    const countEl = document.getElementById("student-count")!;
    const searchInput = document.getElementById("student-search") as HTMLInputElement;
    const template = document.getElementById("student-card-template") as HTMLTemplateElement;

    const { data: profiles } = await supabase
      .from("profiles")
      .select("id, full_name, email, phone, created_at")
      .order("created_at", { ascending: false });

    const { data: enrollmentRows } = await supabase.from("enrollments").select("user_id, course_slug");

    loadingState?.classList.add("hidden");

    if (!profiles || profiles.length === 0) {
      emptyState?.classList.remove("hidden");
    } else {
      countEl.textContent = `${profiles.length} alumno${profiles.length === 1 ? "" : "s"}`;

      const enrollmentsByUser = new Map<string, Set<string>>();
      for (const row of enrollmentRows ?? []) {
        const set = enrollmentsByUser.get(row.user_id) ?? new Set<string>();
        set.add(row.course_slug);
        enrollmentsByUser.set(row.user_id, set);
      }

      function renderStudent(profile: Profile) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const name = profile.full_name || "(sin nombre)";
        const email = profile.email || "";
        const phone = profile.phone || "";
        node.querySelector('[data-field="name"]')!.textContent = name;
        node.querySelector('[data-field="email"]')!.textContent = email;
        const phoneEl = node.querySelector('[data-field="phone"]')!;
        if (phone) phoneEl.textContent = phone;
        else phoneEl.remove();

        const coursesEl = node.querySelector('[data-field="courses"]') as HTMLElement;
        const userEnrollments = enrollmentsByUser.get(profile.id) ?? new Set<string>();

        if (freeCourse) {
          const badge = document.createElement("span");
          badge.className = "rounded-full bg-navy-50 px-4 py-2 text-xs font-bold text-navy-500";
          badge.textContent = `${freeCourse.title} (automático)`;
          coursesEl.appendChild(badge);
        }

        for (const course of paidCourses) {
          const button = document.createElement("button");
          button.type = "button";

          const setButtonState = (hasAccess: boolean) => {
            button.textContent = hasAccess ? `✓ ${course.title}` : `+ ${course.title}`;
            button.className = hasAccess
              ? "rounded-full bg-sky-600 px-4 py-2 text-xs font-bold text-white"
              : "rounded-full border border-navy-200 px-4 py-2 text-xs font-bold text-navy-600 hover:border-sky-400";
          };
          setButtonState(userEnrollments.has(course.slug));

          button.addEventListener("click", async () => {
            button.disabled = true;
            const currentlyHas = userEnrollments.has(course.slug);

            if (currentlyHas) {
              const { error } = await supabase
                .from("enrollments")
                .delete()
                .eq("user_id", profile.id)
                .eq("course_slug", course.slug);
              if (!error) {
                userEnrollments.delete(course.slug);
                setButtonState(false);
              }
            } else {
              const { error } = await supabase
                .from("enrollments")
                .insert({ user_id: profile.id, course_slug: course.slug, granted_by: admin.user.id });
              if (!error) {
                userEnrollments.add(course.slug);
                setButtonState(true);
              }
            }
            button.disabled = false;
          });

          coursesEl.appendChild(button);
        }

        const revokeButton = node.querySelector('[data-field="revoke"]') as HTMLButtonElement;
        if (paidCourses.length === 0) {
          revokeButton.remove();
        } else {
          revokeButton.disabled = userEnrollments.size === 0;
          revokeButton.addEventListener("click", async () => {
            const confirmed = window.confirm(
              `¿Quitar todo el acceso a cursos de pago de ${name}? Su cuenta y su progreso no se borran, solo pierde acceso — puedes volver a dárselo cuando quieras.`,
            );
            if (!confirmed) return;

            revokeButton.disabled = true;
            const { error } = await supabase.from("enrollments").delete().eq("user_id", profile.id);
            if (!error) {
              userEnrollments.clear();
              coursesEl.querySelectorAll("button").forEach((btn) => {
                if (btn === revokeButton) return;
                btn.textContent = btn.textContent!.replace(/^✓/, "+");
                btn.className = "rounded-full border border-navy-200 px-4 py-2 text-xs font-bold text-navy-600 hover:border-sky-400";
              });
            } else {
              revokeButton.disabled = false;
            }
          });
        }

        const card = node.querySelector('[data-field="card"]') as HTMLElement;
        card.dataset.searchText = `${name} ${email} ${phone}`.toLowerCase();

        list.appendChild(node);
      }

      for (const profile of profiles) renderStudent(profile);
      list.classList.remove("hidden");

      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;
        list.querySelectorAll<HTMLElement>('[data-field="card"]').forEach((card) => {
          const matches = !query || (card.dataset.searchText ?? "").includes(query);
          card.classList.toggle("hidden", !matches);
          if (matches) visibleCount += 1;
        });
        noResultsState?.classList.toggle("hidden", visibleCount > 0 || !query);
      });
    }
  }
</script>
