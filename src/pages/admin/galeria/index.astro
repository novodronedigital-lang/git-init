---
import AdminShell from "../../../components/admin/AdminShell.astro";
import Icon from "../../../components/Icon.astro";
---

<AdminShell active="galeria" title="Galería" description="Galerías privadas de fotos y vídeos por taller o jornada.">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Galería</h1>
    <p id="gallery-count" class="text-xs font-semibold text-navy-400"></p>
  </div>
  <p class="mt-1 text-[13.5px] text-navy-500">
    Crea una galería por taller o jornada, sube las fotos y vídeos, y comparte el enlace con las familias o el
    colegio. Nadie necesita cuenta ni contraseña para verla — solo el enlace.
  </p>

  <div class="mt-6 max-w-2xl rounded-2xl border border-navy-100 bg-white p-5">
    <h2 class="font-display text-base font-bold text-navy-900">Nueva galería</h2>
    <form id="new-gallery-form" class="mt-4 flex flex-wrap items-end gap-3">
      <div class="min-w-[220px] flex-1">
        <label for="new-gallery-title" class="text-xs font-bold text-navy-500">Título</label>
        <input
          id="new-gallery-title"
          type="text"
          required
          placeholder="Ej. Taller Colegio San José"
          class="mt-1 w-full rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
        />
      </div>
      <div>
        <label for="new-gallery-date" class="text-xs font-bold text-navy-500">Fecha</label>
        <input
          id="new-gallery-date"
          type="date"
          class="mt-1 rounded-xl border border-navy-200 px-4 py-2.5 text-sm text-navy-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
        />
      </div>
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-amber-500/30 transition-colors hover:bg-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Crear
      </button>
    </form>
    <p id="new-gallery-status" class="mt-3 hidden text-sm"></p>
  </div>

  <div class="mt-8 max-w-3xl">
    <p id="loading-state" class="text-sm text-navy-500">Cargando galerías...</p>
    <p id="empty-state" class="hidden rounded-2xl border border-navy-100 bg-white p-8 text-center text-navy-600">
      Todavía no has creado ninguna galería.
    </p>
    <div id="galleries-list" class="hidden space-y-3"></div>
  </div>

  <template id="gallery-card-template">
    <div class="rounded-2xl border border-navy-100 bg-white p-5" data-field="card">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <a data-field="detail-link" class="min-w-0">
          <p class="font-display text-base font-bold text-navy-900 hover:text-sky-700" data-field="title"></p>
          <p class="text-xs text-navy-500" data-field="meta"></p>
        </a>
        <span data-field="draft-badge" class="hidden shrink-0 rounded-full bg-navy-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-navy-500">
          Sin publicar
        </span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-navy-50 pt-3">
        <a data-field="detail-button" class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-3.5 py-1.5 text-xs font-bold text-sky-700 hover:bg-sky-100">
          <Icon name="camera" class="size-3.5" />
          Gestionar fotos y vídeos
        </a>
        <button
          type="button"
          data-field="copy-link"
          class="inline-flex items-center gap-1.5 rounded-full border border-navy-200 px-3.5 py-1.5 text-xs font-bold text-navy-500 hover:border-sky-400 hover:text-sky-700"
        >
          Copiar enlace
        </button>
        <button
          type="button"
          data-field="delete"
          class="inline-flex items-center gap-1.5 rounded-full border border-navy-200 px-3.5 py-1.5 text-xs font-bold text-navy-500 hover:border-red-400 hover:text-red-600"
        >
          Eliminar
        </button>
      </div>
    </div>
  </template>
</AdminShell>

<script>
  import { requireAdmin } from "../../../lib/admin";
  import { adminPath } from "../../../lib/admin";
  import { supabase } from "../../../lib/supabase";
  import { getGaleriaHref } from "../../../data/site";
  import { generateGallerySlug, type Gallery } from "../../../lib/gallery";

  const admin = await requireAdmin();
  if (admin) {
    const loadingState = document.getElementById("loading-state");
    const emptyState = document.getElementById("empty-state");
    const list = document.getElementById("galleries-list")!;
    const countEl = document.getElementById("gallery-count")!;
    const template = document.getElementById("gallery-card-template") as HTMLTemplateElement;

    const dateFormatter = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "short", year: "numeric" });

    async function load() {
      const { data: galleries } = await supabase
        .from("galleries")
        .select("id, slug, title, description, event_date, is_published, created_at")
        .order("event_date", { ascending: false });

      const { data: itemCounts } = await supabase.from("gallery_items").select("gallery_id");
      const countsByGallery = new Map<string, number>();
      for (const row of itemCounts ?? []) {
        countsByGallery.set(row.gallery_id, (countsByGallery.get(row.gallery_id) ?? 0) + 1);
      }

      loadingState?.classList.add("hidden");
      list.innerHTML = "";

      if (!galleries || galleries.length === 0) {
        emptyState?.classList.remove("hidden");
        list.classList.add("hidden");
        countEl.textContent = "";
        return;
      }

      emptyState?.classList.add("hidden");
      list.classList.remove("hidden");
      countEl.textContent = `${galleries.length} galería${galleries.length === 1 ? "" : "s"}`;

      for (const g of galleries as Gallery[]) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const detailHref = adminPath(`/galeria/detalle?id=${g.id}`);

        const titleEl = node.querySelector('[data-field="title"]')!;
        titleEl.textContent = g.title;
        (node.querySelector('[data-field="detail-link"]') as HTMLAnchorElement).href = detailHref;

        const count = countsByGallery.get(g.id) ?? 0;
        node.querySelector('[data-field="meta"]')!.textContent =
          `${dateFormatter.format(new Date(g.event_date + "T00:00:00"))} · ${count} archivo${count === 1 ? "" : "s"}`;

        if (!g.is_published) node.querySelector('[data-field="draft-badge"]')?.classList.remove("hidden");

        (node.querySelector('[data-field="detail-button"]') as HTMLAnchorElement).href = detailHref;

        const copyButton = node.querySelector('[data-field="copy-link"]') as HTMLButtonElement;
        copyButton.addEventListener("click", async () => {
          const url = getGaleriaHref(g.slug);
          const absoluteUrl = url.startsWith("http") ? url : `${window.location.origin}${url}`;
          await navigator.clipboard.writeText(absoluteUrl);
          const original = copyButton.textContent;
          copyButton.textContent = "¡Copiado!";
          setTimeout(() => (copyButton.textContent = original), 1500);
        });

        const deleteButton = node.querySelector('[data-field="delete"]') as HTMLButtonElement;
        deleteButton.addEventListener("click", async () => {
          const confirmed = window.confirm(
            `¿Eliminar la galería "${g.title}" y todas sus fotos/vídeos? Esta acción no se puede deshacer.`,
          );
          if (!confirmed) return;

          deleteButton.disabled = true;

          const { data: items } = await supabase.from("gallery_items").select("storage_path").eq("gallery_id", g.id);
          const paths = (items ?? []).map((i) => i.storage_path);
          if (paths.length > 0) await supabase.storage.from("gallery-media").remove(paths);

          const { error } = await supabase.from("galleries").delete().eq("id", g.id);
          if (!error) await load();
          else deleteButton.disabled = false;
        });

        list.appendChild(node);
      }
    }

    await load();

    const form = document.getElementById("new-gallery-form") as HTMLFormElement;
    const titleInput = document.getElementById("new-gallery-title") as HTMLInputElement;
    const dateInput = document.getElementById("new-gallery-date") as HTMLInputElement;
    const status = document.getElementById("new-gallery-status")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const title = titleInput.value.trim();
      if (!title) return;

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.classList.add("hidden");

      const slug = generateGallerySlug(title);
      const { error } = await supabase.from("galleries").insert({
        title,
        slug,
        event_date: dateInput.value || new Date().toISOString().slice(0, 10),
      });

      submitButton.disabled = false;

      if (error) {
        status.textContent = "No se ha podido crear: " + error.message;
        status.className = "mt-3 text-sm text-red-700";
        status.classList.remove("hidden");
        return;
      }

      titleInput.value = "";
      dateInput.value = "";
      await load();
    });
  }
</script>
