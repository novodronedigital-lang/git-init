---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
---

<Layout title="Admin" description="Panel de administración de DronEduca.">
  <section class="bg-sky-50/60 py-12 sm:py-16">
    <div class="container-page">
      <span class="inline-block rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-sky-700 shadow-sm ring-1 ring-sky-100">
        Admin
      </span>
      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
        Panel de administración
      </h1>
      <button
        id="publish-button"
        type="button"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-navy-950 px-6 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-navy-800 disabled:cursor-not-allowed disabled:opacity-60"
      >
        <Icon name="check" class="size-4" />
        Publicar cambios
      </button>
      <p id="publish-status" class="mt-3 hidden text-sm text-navy-600"></p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page max-w-4xl space-y-10">
      <div>
        <h2 class="font-display text-xl font-bold text-navy-900">Contenido</h2>
        <a
          href="/admin/contenido"
          class="mt-4 flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
        >
          <Icon name="book" class="size-5 text-sky-600" />
          <span class="text-sm font-semibold text-navy-800">Editar los textos de Inicio, Quiénes somos, Servicios y Precios</span>
        </a>
      </div>

      <div>
        <h2 class="font-display text-xl font-bold text-navy-900">Alumnos</h2>
        <a
          href="/admin/alumnos"
          class="mt-4 flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
        >
          <Icon name="users" class="size-5 text-sky-600" />
          <span class="text-sm font-semibold text-navy-800">Ver alumnos registrados y gestionar accesos a cursos</span>
        </a>
      </div>

      <div>
        <h2 class="font-display text-xl font-bold text-navy-900">Cursos</h2>
        <div class="mt-4 space-y-4">
          {courses.map((course) => (
            <div class="rounded-2xl border border-navy-100 bg-white p-5">
              <h3 class="font-display text-base font-bold text-navy-900">{course.data.title}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                <a
                  href={`/admin/cursos/${course.id}/lecciones`}
                  class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-4 py-2 text-xs font-bold text-sky-700 hover:bg-sky-100"
                >
                  Lecciones
                </a>
                <a
                  href={`/admin/cursos/${course.id}/examen`}
                  class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-4 py-2 text-xs font-bold text-amber-700 hover:bg-amber-100"
                >
                  Examen
                </a>
                {course.data.calendar && (
                  <a
                    href={`/admin/cursos/${course.id}/calendario`}
                    class="inline-flex items-center gap-1.5 rounded-full bg-navy-50 px-4 py-2 text-xs font-bold text-navy-700 hover:bg-navy-100"
                  >
                    Calendario
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireAdmin } from "../../lib/admin";
  import { supabase } from "../../lib/supabase";

  await requireAdmin();

  const publishButton = document.getElementById("publish-button") as HTMLButtonElement;
  const publishStatus = document.getElementById("publish-status")!;

  publishButton.addEventListener("click", async () => {
    publishButton.disabled = true;
    publishStatus.textContent = "Publicando... puede tardar 1-2 minutos.";
    publishStatus.classList.remove("hidden");

    const { error } = await supabase.functions.invoke("publish");

    publishButton.disabled = false;
    publishStatus.textContent = error
      ? "No se ha podido lanzar la publicación: " + error.message
      : "¡Publicación lanzada! Revisa la pestaña Actions de GitHub para ver el progreso.";
  });
</script>
