---
import AdminShell from "../../components/admin/AdminShell.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { adminPath } from "../../lib/admin";

const courses = await getCollection("courses");
---

<AdminShell active="dashboard" title="Dashboard">
  <h1 class="font-display text-2xl font-extrabold text-navy-900 sm:text-[26px]">Panel de administración</h1>

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <button
      id="publish-button"
      type="button"
      class="inline-flex items-center gap-2 rounded-full bg-navy-950 px-6 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-navy-800 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <Icon name="check" class="size-4" />
      Publicar cambios
    </button>
    <button
      id="maintenance-button"
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-navy-200 bg-white px-6 py-3 text-sm font-bold text-navy-700 transition-colors hover:border-red-400 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <Icon name="lock" class="size-4" />
      <span id="maintenance-button-label">Cargando...</span>
    </button>
  </div>
  <p id="publish-status" class="mt-3 hidden text-sm text-navy-600"></p>
  <p id="maintenance-status" class="mt-1 hidden text-sm text-navy-600"></p>

  <div class="mt-10 max-w-4xl space-y-10">
    <div>
      <h2 class="font-display text-lg font-bold text-navy-900">Contenido</h2>
      <a
        href={adminPath("/contenido")}
        class="mt-4 flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
      >
        <Icon name="book" class="size-5 text-sky-600" />
        <span class="text-sm font-semibold text-navy-800">Editar los textos de Inicio, Quiénes somos, Servicios y Precios</span>
      </a>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold text-navy-900">Alumnos</h2>
      <a
        href={adminPath("/alumnos")}
        class="mt-4 flex items-center gap-4 rounded-2xl border border-navy-100 bg-white px-5 py-4 transition-colors hover:border-sky-300"
      >
        <Icon name="users" class="size-5 text-sky-600" />
        <span class="text-sm font-semibold text-navy-800">Ver alumnos registrados y gestionar accesos a cursos</span>
      </a>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold text-navy-900">Cursos</h2>
      <div class="mt-4 space-y-4">
        {courses.map((course) => (
          <div class="rounded-2xl border border-navy-100 bg-white p-5">
            <h3 class="font-display text-base font-bold text-navy-900">{course.data.title}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={adminPath(`/cursos/${course.id}/lecciones`)}
                class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-4 py-2 text-xs font-bold text-sky-700 hover:bg-sky-100"
              >
                Lecciones
              </a>
              <a
                href={adminPath(`/cursos/${course.id}/examen`)}
                class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-4 py-2 text-xs font-bold text-amber-700 hover:bg-amber-100"
              >
                Examen
              </a>
              {course.data.calendar && (
                <a
                  href={adminPath(`/cursos/${course.id}/calendario`)}
                  class="inline-flex items-center gap-1.5 rounded-full bg-navy-50 px-4 py-2 text-xs font-bold text-navy-700 hover:bg-navy-100"
                >
                  Calendario
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminShell>

<script>
  import { requireAdmin } from "../../lib/admin";
  import { supabase } from "../../lib/supabase";
  import { getMaintenanceMode, setMaintenanceMode } from "../../lib/maintenance";

  await requireAdmin();

  const publishButton = document.getElementById("publish-button") as HTMLButtonElement;
  const publishStatus = document.getElementById("publish-status")!;

  publishButton.addEventListener("click", async () => {
    publishButton.disabled = true;
    publishStatus.textContent = "Publicando... puede tardar 1-2 minutos.";
    publishStatus.classList.remove("hidden");

    const { error } = await supabase.functions.invoke("publish");

    publishButton.disabled = false;
    publishStatus.textContent = error
      ? "No se ha podido lanzar la publicación: " + error.message
      : "¡Publicación lanzada! Revisa la pestaña Actions de GitHub para ver el progreso.";
  });

  const maintenanceButton = document.getElementById("maintenance-button") as HTMLButtonElement;
  const maintenanceLabel = document.getElementById("maintenance-button-label")!;
  const maintenanceStatus = document.getElementById("maintenance-status")!;

  function renderMaintenanceState(enabled: boolean) {
    maintenanceLabel.textContent = enabled ? "Desactivar modo mantenimiento" : "Activar modo mantenimiento";
    maintenanceButton.classList.toggle("border-red-300", enabled);
    maintenanceButton.classList.toggle("text-red-700", enabled);
    maintenanceStatus.textContent = enabled
      ? "Activo: nadie fuera del equipo ve la web pública ahora mismo."
      : "";
    maintenanceStatus.classList.toggle("hidden", !enabled);
  }

  let maintenanceEnabled = await getMaintenanceMode();
  renderMaintenanceState(maintenanceEnabled);

  maintenanceButton.addEventListener("click", async () => {
    maintenanceButton.disabled = true;
    const next = !maintenanceEnabled;
    const { error } = await setMaintenanceMode(next);
    maintenanceButton.disabled = false;

    if (error) {
      maintenanceStatus.textContent = "No se ha podido cambiar: " + error.message;
      maintenanceStatus.classList.remove("hidden");
      return;
    }

    maintenanceEnabled = next;
    renderMaintenanceState(maintenanceEnabled);
  });
</script>
