---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
---

<Layout
  title="Cursos online"
  description="Cursos online de DronEduca para aprender a volar drones a tu ritmo: desde un curso gratuito de iniciación hasta la formación profesional Novodrone Pilot."
>
  <section class="bg-sky-50/60 py-16 sm:py-20">
    <div class="container-page text-center">
      <span class="inline-block rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-sky-700 shadow-sm ring-1 ring-sky-100">
        Formación online
      </span>
      <h1 class="mx-auto mt-4 max-w-2xl font-display text-4xl font-extrabold leading-tight text-navy-900 sm:text-5xl">
        Cursos online de drones
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-navy-600">
        Desde un primer contacto gratuito hasta la formación profesional completa. Aprende a tu ritmo, con
        seguimiento de tu progreso y exámenes para comprobar lo aprendido.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/campus"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-sky-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-sky-600/30 transition-colors hover:bg-sky-700"
        >
          <Icon name="user" class="size-4" />
          Ya tengo cuenta
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container-page grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {courses.map((course) => {
        const totalLessons = course.data.modules.reduce((sum, m) => sum + m.lessons.length, 0);
        const isNovodrone = course.data.brand === "novodrone";
        return (
          <a
            href={`/cursos/${course.id}`}
            class="group flex flex-col overflow-hidden rounded-[20px] border border-navy-100 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-900/10"
          >
            {course.data.thumbnail ? (
              <div class="aspect-video overflow-hidden bg-navy-950">
                <img
                  src={course.data.thumbnail}
                  alt={course.data.title}
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </div>
            ) : (
              <div
                class="relative flex aspect-video flex-col items-center justify-center gap-2 text-white/60"
                style={
                  isNovodrone
                    ? "background:linear-gradient(150deg,#103b96,#0a1120)"
                    : "background:linear-gradient(150deg,#4ea1ff,#0c46c2)"
                }
              >
                <Icon name="camera" class="size-6" />
                <span class="text-xs">Miniatura de {course.data.title} próximamente</span>
              </div>
            )}

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2">
                {isNovodrone && (
                  <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-navy-950 px-3 py-1 text-xs font-bold text-white">
                    Novodrone
                  </span>
                )}
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1 text-xs font-bold text-sky-700">
                  {course.data.category}
                </span>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                  {course.data.level}
                </span>
              </div>

              <h2 class="mt-4 font-display text-xl font-bold text-navy-900">{course.data.title}</h2>
              {course.data.tagline && <p class="mt-1 text-sm font-semibold text-sky-700">{course.data.tagline}</p>}
              <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-600">{course.data.description}</p>

              <div class="mt-5 flex items-center justify-between">
                <span class="font-display text-lg font-extrabold text-navy-900">{course.data.price}</span>
                <span class="text-xs text-navy-400">{totalLessons} lecciones</span>
              </div>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-sky-700">
                Ver curso
                <Icon name="arrow-right" class="size-3.5 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
