---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const courses = await getCollection("courses");
---

<Layout
  title="Cursos online"
  description="Cursos online de DronEduca para aprender a volar drones a tu ritmo: desde un curso gratuito de iniciación hasta la formación profesional Novodrone Pilot."
>
  <section class="bg-sky-50/60 py-16 sm:py-20">
    <div class="container-page text-center">
      <span class="inline-block rounded-full bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-sky-700 shadow-sm ring-1 ring-sky-100">
        Formación online
      </span>
      <h1 class="mx-auto mt-4 max-w-2xl font-display text-4xl font-extrabold leading-tight text-navy-900 sm:text-5xl">
        Cursos online de drones
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-navy-600">
        Desde un primer contacto gratuito hasta la formación profesional completa. Elige tu punto de partida.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/campus"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-sky-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-sky-600/30 transition-colors hover:bg-sky-700"
        >
          <Icon name="user" class="size-4" />
          Acceder al campus
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container-page mx-auto flex max-w-4xl flex-col gap-6">
      {courses.map((course) => {
        const isFlagship = course.data.brand === "novodrone";
        const hasCta = Boolean(course.data.ctaHref);
        const isExternalCta = hasCta && /^https?:\/\//.test(course.data.ctaHref!);

        return (
          <div
            class:list={[
              "flex flex-col overflow-hidden rounded-[22px] border bg-white shadow-sm transition-all hover:shadow-lg lg:flex-row",
              isFlagship ? "border-2 border-amber-400 shadow-amber-400/10" : "border-navy-100",
            ]}
          >
            <div class="relative aspect-video overflow-hidden bg-navy-950 lg:aspect-auto lg:w-[38%] lg:shrink-0">
              {isFlagship && (
                <span class="absolute left-3.5 top-3.5 z-10 inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-3 py-1 text-[11px] font-bold text-white shadow-sm">
                  <Icon name="spark" class="size-3.5" />
                  Formación insignia
                </span>
              )}
              {course.data.thumbnail ? (
                <img src={course.data.thumbnail} alt={course.data.title} class="absolute inset-0 size-full object-cover" />
              ) : (
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-white/60"
                  style={
                    isFlagship
                      ? "background:linear-gradient(150deg,#103b96,#0a1120)"
                      : "background:linear-gradient(150deg,#4ea1ff,#0c46c2)"
                  }
                >
                  <Icon name="camera" class="size-6" />
                  <span class="text-xs">Miniatura de {course.data.title} próximamente</span>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <div class="flex flex-wrap items-center gap-2">
                {isFlagship && (
                  <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-navy-950 px-3 py-1 text-xs font-bold text-white">
                    Novodrone
                  </span>
                )}
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1 text-xs font-bold text-sky-700">
                  {course.data.category}
                </span>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                  {course.data.level}
                </span>
              </div>

              <h2 class="mt-3 font-display text-2xl font-bold text-navy-900">{course.data.title}</h2>
              {course.data.tagline && <p class="mt-1 text-sm font-semibold text-sky-700">{course.data.tagline}</p>}
              <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-600">{course.data.description}</p>

              <div class="mt-6 flex flex-wrap items-center gap-3">
                {hasCta ? (
                  <a
                    href={course.data.ctaHref}
                    target={isExternalCta ? "_blank" : undefined}
                    rel={isExternalCta ? "noopener noreferrer" : undefined}
                    class:list={[
                      "inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-bold text-white shadow-md transition-colors",
                      isFlagship
                        ? "bg-amber-500 shadow-amber-500/30 hover:bg-amber-600"
                        : "bg-sky-600 shadow-sky-600/30 hover:bg-sky-700",
                    ]}
                  >
                    {course.data.ctaLabel ?? "Empezar"}
                    <Icon name="arrow-right" class="size-4" />
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 rounded-full bg-navy-50 px-6 py-3 text-sm font-bold text-navy-400">
                    {course.data.ctaLabel ?? "Próximamente"}
                  </span>
                )}
                <a href={`/cursos/${course.id}`} class="inline-flex items-center gap-1 text-sm font-bold text-sky-700 hover:underline">
                  Ver detalles del curso
                  <Icon name="arrow-right" class="size-3.5" />
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
