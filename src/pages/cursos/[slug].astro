---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const isNovodrone = course.data.brand === "novodrone";

let lessonNumber = 0;
const modulesWithNumbers = course.data.modules.map((mod) => ({
  ...mod,
  lessons: mod.lessons.map((title) => {
    lessonNumber += 1;
    return { number: lessonNumber, title };
  }),
}));
const totalLessons = lessonNumber;
---

<Layout title={course.data.title} description={course.data.description}>
  <article class="py-16 sm:py-20">
    <div class="container-page max-w-3xl">
      <a href="/cursos" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
        ← Volver a los cursos
      </a>

      {isNovodrone && <img src="/brand/novodrone-logo.png" alt="Novodrone" class="mt-6 h-10 w-auto" />}

      <div class:list={["flex items-center gap-2", isNovodrone ? "mt-4" : "mt-6"]}>
        <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1 text-xs font-bold text-sky-700">
          {course.data.category}
        </span>
        <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
          {course.data.level}
        </span>
      </div>

      <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-navy-900 sm:text-4xl">
        {course.data.title}
      </h1>
      {course.data.tagline && <p class="mt-2 text-lg font-semibold text-sky-700">{course.data.tagline}</p>}
      <p class="mt-4 text-lg text-navy-600">{course.data.description}</p>

      <div class="mt-6 flex items-center gap-4">
        <span class="font-display text-3xl font-extrabold text-navy-900">{course.data.price}</span>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button href="/registro" variant="primary">
          Crear cuenta gratis
          <Icon name="arrow-right" class="size-4" />
        </Button>
        <Button href="/login" variant="ghost">Ya tengo cuenta</Button>
      </div>

      <div class="prose-content mt-10">
        <Content />
      </div>

      {course.data.includes && course.data.includes.length > 0 && (
        <div class="mt-10 rounded-3xl border border-navy-100 bg-sky-50 p-6 sm:p-8">
          <h2 class="font-display text-xl font-bold text-navy-900">Qué incluye</h2>
          <ul class="mt-4 space-y-2">
            {course.data.includes.map((item) => (
              <li class="flex items-center gap-2.5 text-sm font-medium text-navy-700">
                <Icon name="check" class="size-4 shrink-0 text-sky-600" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-10 rounded-3xl border border-navy-100 bg-white p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-navy-900">Temario ({totalLessons} lecciones)</h2>
        <div class="mt-5 space-y-6">
          {modulesWithNumbers.map((mod) => (
            <div>
              <h3 class="font-display text-sm font-bold uppercase tracking-wide text-navy-500">{mod.title}</h3>
              <ul class="mt-3 space-y-2">
                {mod.lessons.map((lesson) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-navy-50 px-4 py-3 text-sm text-navy-700">
                    <Icon name="lock" class="size-4 shrink-0 text-navy-400" />
                    {lesson.title}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>
</Layout>
