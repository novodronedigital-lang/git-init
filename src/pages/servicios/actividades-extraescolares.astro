---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CtaSection from "../../components/CtaSection.astro";
import { getContent } from "../../lib/content";

interface Level {
  title: string;
  description: string;
}

const content = await getContent("servicios.actividades-extraescolares", {
  hero: {
    title: "Actividades extraescolares con drones",
    description:
      "Nuestra actividad principal: clases extraescolares de drones en colegios, donde los jóvenes pilotos aprenden a volar con seguridad a través de formación de calidad y muchas horas de diversión, semana a semana durante todo el curso.",
    note: "La solicitud debe partir del AMPA o del equipo directivo del centro. Escríbenos y nos ponemos en contacto directamente con el colegio para organizarlo todo.",
  },
  levels: [
    { title: "Nivel 1 · Despegue", description: "Seguridad, normativa básica y primeros vuelos guiados con drones de iniciación." },
    { title: "Nivel 2 · Control", description: "Maniobras de precisión, circuitos sencillos y primeras nociones de mantenimiento del equipo." },
    { title: "Nivel 3 · Piloto avanzado", description: "Vuelo en formación, introducción al FPV y primeros retos de velocidad y precisión." },
  ] as Level[],
  included: [
    "Drones y material homologado para cada nivel",
    "Monitor especializado en cada sesión",
    "Seguro de responsabilidad civil de la actividad",
    "Informe de progreso por trimestre",
    "Espacio interior o exterior según el colegio",
  ] as string[],
});
---

<Layout
  title="Actividades extraescolares con drones"
  description="Clases extraescolares semanales de drones para colegios: seguridad, formación de calidad y progresión por niveles hasta el vuelo real."
>
  <section class="bg-sky-50/60 py-16 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <a href="/servicios" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700">
          <Icon name="arrow-right" class="size-4 rotate-180" />
          Volver a servicios
        </a>
        <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight text-navy-900 sm:text-5xl">
          {content.hero.title}
        </h1>
        <p class="mt-5 text-lg text-navy-600">
          {content.hero.description}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contacto" variant="primary">
            Llevar esta actividad a mi colegio
            <Icon name="arrow-right" class="size-4" />
          </Button>
          <Button href="/precios" variant="ghost">Ver precios</Button>
        </div>
        <p class="mt-4 text-sm text-navy-500">
          {content.hero.note}
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-navy-100">
          <Icon name="calendar" class="size-7 text-sky-600" />
          <p class="mt-3 font-display text-lg font-bold text-navy-900">Sesión semanal</p>
          <p class="mt-1 text-xs text-navy-500">Durante todo el curso escolar</p>
        </div>
        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-navy-100">
          <Icon name="users" class="size-7 text-sky-600" />
          <p class="mt-3 font-display text-lg font-bold text-navy-900">Grupos reducidos</p>
          <p class="mt-1 text-xs text-navy-500">Atención cercana por nivel</p>
        </div>
        <div class="col-span-2 rounded-3xl bg-navy-950 p-6 text-white">
          <Icon name="shield" class="size-7 text-sky-300" />
          <p class="mt-3 font-display text-lg font-bold">Edad recomendada: desde 8 años</p>
          <p class="mt-1 text-xs text-navy-300">Material y ejercicios adaptados a cada edad</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container-page">
      <SectionHeading eyebrow="Metodología" title="Una progresión pensada por niveles" />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {content.levels.map((level: Level, i: number) => (
          <div class="rounded-3xl border border-navy-100 bg-white p-7">
            <span class="font-display text-4xl font-extrabold text-sky-100">0{i + 1}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-navy-900">{level.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{level.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-navy-100 bg-navy-50 py-20 sm:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <span class="inline-block rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-wide text-sky-700">
          Qué incluye
        </span>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-navy-900">Todo listo para empezar a volar</h2>
        <p class="mt-4 text-navy-600">
          Nos encargamos de todo el material y la formación del monitorado. El colegio solo tiene que ceder el
          espacio y nosotros llevamos el resto.
        </p>
      </div>
      <ul class="space-y-3">
        {content.included.map((item: string) => (
          <li class="flex items-start gap-3 rounded-2xl bg-white p-4 text-sm font-medium text-navy-700 shadow-sm">
            <Icon name="check" class="mt-0.5 size-5 shrink-0 text-sky-600" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaSection
    title="¿Quieres esta actividad en tu colegio el próximo curso?"
    description="Escríbenos con el nombre del centro y el número aproximado de alumnos interesados."
  />
</Layout>
